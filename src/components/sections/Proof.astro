---
// One piece of work that backs up a service page: a project we delivered or a product we run.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text: string;
  href: string;
  label: string;
  // data-umami-event-label for the link
  event: string;
  image?: ImageMetadata;
  alt?: string;
}

const { title, text, href, label, event, image, alt = '' } = Astro.props;
---

<section class="block">
  <div class="container">
    <div class:list={['proof reveal', { 'proof--text': !image }]}>
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
        <a
          href={href}
          class="btn btn--secondary btn--lg"
          data-umami-event="cta-click"
          data-umami-event-location="proof"
          data-umami-event-label={event}
        >{label}</a>
      </div>
      {image && (
        <a class="proof__shot" href={href} tabindex="-1" aria-hidden="true">
          <Image src={image} alt={alt} widths={[480, 760, 1200]} sizes="(max-width: 880px) 100vw, 600px" />
        </a>
      )}
    </div>
  </div>
</section>
