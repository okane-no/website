---
const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    title: 'Enkel oppsett',
    description: 'Gå fra idé til nettbutikk på under 30 minutter. Velg design, legg til produkter, aktiver betaling — ferdig.',
    badge: 'Raskest i test',
    badgeColor: 'bg-yellow-100 text-yellow-700',
    bgColor: 'bg-yellow-50',
    iconColor: 'text-yellow-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>`,
    title: 'Vipps & Klarna innebygd',
    description: 'Alle nordmenns favorittbetalinger er klar fra dag én — Vipps, Klarna, Stripe og alle vanlige betalingskort.',
    badge: 'Norsk favoritt',
    badgeColor: 'bg-orange-100 text-orange-700',
    bgColor: 'bg-orange-50',
    iconColor: 'text-orange-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
    title: 'Lager & WMS',
    description: 'Full kontroll på lagerbeholdningen med innebygd lagerstyring. Varsler ved lav beholdning — aldri selg noe du ikke har.',
    badge: 'Unikt for Okane',
    badgeColor: 'bg-blue-100 text-blue-700',
    bgColor: 'bg-blue-50',
    iconColor: 'text-blue-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    title: 'Norsk regnskap synkronisert',
    description: 'Koble direkte mot Visma, Tripletex eller Fiken. Alle ordre, fakturaer og betalinger bokføres automatisk.',
    badge: 'Spar timer/uke',
    badgeColor: 'bg-green-100 text-green-700',
    bgColor: 'bg-green-50',
    iconColor: 'text-green-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
    title: 'SEO-klar fra dag én',
    description: 'Teknisk SEO er innebygd — strukturerte data, lynraske sider, mobiloptimalisering og automatisk sitemap.',
    badge: 'Google-elsket',
    badgeColor: 'bg-purple-100 text-purple-700',
    bgColor: 'bg-purple-50',
    iconColor: 'text-purple-600',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    title: 'Ekte norsk support',
    description: 'Hjelp på norsk fra ekte nordmenn som kjenner norsk e-handel. Telefon, chat og e-post — vi svarer raskt.',
    badge: 'Under 2 min respons',
    badgeColor: 'bg-red-100 text-red-700',
    bgColor: 'bg-red-50',
    iconColor: 'text-red-600',
  },
];
---

<section id="funksjoner" class="py-20 md:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 text-sm font-semibold text-blue-700 bg-blue-100 rounded-full mb-4">Funksjoner</span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 tracking-tight">
        Alt du trenger<br />
        <span class="text-blue-600">for å lykkes</span>
      </h2>
      <p class="text-lg md:text-xl text-slate-500 max-w-2xl mx-auto">
        Vi har tenkt på alt slik at du kan fokusere på det du er best på — å drive bedrift.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {features.map(({ icon, title, description, badge, badgeColor, bgColor, iconColor }) => (
        <div class="group relative p-6 md:p-7 rounded-2xl border border-slate-200 hover:border-slate-300 bg-white hover:shadow-lg hover:shadow-slate-200/60 transition-all duration-300">
          <div class={`inline-flex w-12 h-12 ${bgColor} ${iconColor} rounded-xl items-center justify-center mb-5`}>
            <Fragment set:html={icon} />
          </div>
          <div class="flex items-start justify-between gap-2 mb-3">
            <h3 class="text-lg font-bold text-slate-900">{title}</h3>
            <span class={`flex-shrink-0 px-2 py-0.5 text-xs font-medium rounded-full ${badgeColor}`}>{badge}</span>
          </div>
          <p class="text-slate-500 leading-relaxed text-sm md:text-base">{description}</p>
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-14 text-center">
      <a href="#priser" class="inline-flex items-center gap-2 px-7 py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors shadow-sm shadow-blue-600/20 text-base">
        Se alle funksjoner og priser
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
