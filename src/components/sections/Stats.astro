---
const stats = [
  { value: '500+', label: 'Norske nettbutikker', icon: '🏪' },
  { value: '99.9%', label: 'Garantert oppetid', icon: '⚡' },
  { value: '< 30 min', label: 'Gjennomsnittlig oppsett', icon: '🚀' },
  { value: '4.9/5', label: 'Kundetilfredshet', icon: '⭐' },
];
---

<section class="bg-blue-950 text-white py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-0 md:divide-x md:divide-white/10">
      {stats.map(({ value, label, icon }) => (
        <div class="text-center md:px-8">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">{value}</div>
          <div class="text-sm text-blue-300">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
