---
// The closing section on every page. The header button links here (#kontakt).
import { mailto, prompts } from '~/lib/contact';

interface Action {
  label: string;
  href: string;
  // data-umami-event-label: what the click does, the same on every page
  event: string;
}

interface Props {
  title?: string;
  text?: string;
  primary?: Action;
  secondary?: Action;
}

const {
  title = 'Fortell oss hva du vil bygge.',
  text = 'Send noen linjer om hva du trenger, så svarer vi med hvordan vi ville løst det og hva det vil koste.',
  primary = { label: 'Be om pris og plan', href: mailto('Prosjekt', prompts.project), event: 'pris-og-plan' },
  secondary = { label: 'Les vanlige spørsmål', href: '#faq', event: 'les-faq' },
} = Astro.props;
---

<section class="cta" id="kontakt">
  <div class="container">
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta__row">
      <a
        href={primary.href}
        class="btn btn--primary btn--xl"
        data-umami-event="cta-click"
        data-umami-event-location="cta"
        data-umami-event-label={primary.event}
      >{primary.label}</a>
      {secondary && (
        <a
          href={secondary.href}
          class="btn btn--ghost btn--xl"
          data-umami-event="cta-click"
          data-umami-event-location="cta"
          data-umami-event-label={secondary.event}
        >{secondary.label}</a>
      )}
    </div>
    <slot />
  </div>
</section>
