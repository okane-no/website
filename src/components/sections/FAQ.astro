---
// Questions and answers. The front page uses the defaults; each service page passes its own.
// An answer is HTML, so it can link to a project or product.
interface Item {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  sub?: string;
  items?: Item[];
}

const defaults: Item[] = [
  {
    q: 'Hva koster det?',
    a: 'Det avhenger av omfanget, men du får alltid en konkret pris før vi starter, og vi sier ifra før noe endrer seg.',
  },
  {
    q: 'Hvem eier koden?',
    a: 'Du. Alt vi bygger for deg leveres med full tilgang til kildekode, data og infrastruktur. Ingen innlåsing.',
  },
  {
    q: 'Kan dere ta over et eksisterende system?',
    a: 'Ja. Vi starter med en gjennomgang av det du har, så du får en ærlig vurdering av tilstanden og en plan for veien videre.',
  },
  {
    q: 'Tilbyr dere drift og vedlikehold?',
    a: 'Ja. Vi drifter egne produkter hver dag, så overvåking og beredskap er allerede på plass. Etter lansering kan vi fortsette på en løpende avtale.',
  },
  {
    q: 'Hvilke teknologier bruker dere?',
    a: 'Moderne, men kjedelige med vilje. Velprøvd åpen kildekode fremfor eksperimenter, slik at løsningen kan vedlikeholdes av flere enn oss.',
  },
  {
    q: 'Hvor raskt kan dere starte?',
    a: 'Send noen linjer i dag, så har du svar innen en arbeidsdag. Et konkret forslag kommer som regel innen en uke.',
  },
];

const {
  title = 'Det folk lurer på.',
  sub = 'Rett på sak. Lurer du på noe annet, er det bare å spørre.',
  items = defaults,
} = Astro.props;
---

<section class="block" id="faq">
  <div class="container">
    <header class="block__header reveal">
      <div class="block__sub-wrap">
        <h2 class="block__title">{title}</h2>
        <p class="block__sub">{sub}</p>
      </div>
    </header>

    <div class="faq-list reveal">
      {items.map((item) => (
        <details>
          <summary><span>{item.q}</span></summary>
          <p set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</section>
