---
import { mailto, prompts } from '~/lib/contact';

const project = mailto('Prosjekt', prompts.project);
---

<section class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero__headline">
        <span data-nb="Vi bygger som om" data-en="We build like">Vi bygger som om</span><br>
        <em data-nb="vi skal drifte det." data-en="we'll run it.">vi skal drifte det.</em>
      </h1>

      <p class="hero__sub" data-nb="Vi drifter Okane Commerce og Digital Mailroom selv, med overvåking og beredskap. Det samme oppsettet får du når vi bygger nettside, nettbutikk, app, integrasjon eller AI-agent for deg." data-en="We run Okane Commerce and Digital Mailroom ourselves, with monitoring and on-call. You get the same setup when we build a website, online store, app, integration or AI agent for you.">
        Vi drifter Okane Commerce og Digital Mailroom selv, med overvåking og beredskap. Det samme oppsettet får du når vi bygger nettside, nettbutikk, app, integrasjon eller AI-agent for deg.
      </p>

      <div class="hero__cta">
        <a href={project} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="pris-og-plan">Be om pris og plan</a>
        <a href="#tjenester" class="btn btn--secondary btn--lg" data-nb="Se tjenestene" data-en="See our services" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="se-tjenestene">Se tjenestene</a>
      </div>

      <div class="hero__meta">
        <span><b data-nb="Kjørende kode" data-en="Running code">Kjørende kode</b> <span data-nb="første uke" data-en="in week one">første uke</span></span>
        <span><b data-nb="Forutsigbar" data-en="Predictable">Forutsigbar</b> <span data-nb="pris" data-en="pricing">pris</span></span>
        <span><b data-nb="Du eier" data-en="You own">Du eier</b> <span data-nb="koden" data-en="the code">koden</span></span>
      </div>
    </div>

    <div class="livecards">
      <div class="livecard">
        <b>Okane Commerce</b>
        <small data-nb="Netthandelsplattform for norske merkevarer" data-en="E-commerce platform for Norwegian brands">Netthandelsplattform for norske merkevarer</small>
      </div>
      <div class="livecard">
        <b>Digital Mailroom</b>
        <small data-nb="Post fra Altinn, EHF og e-post, rutet til rett person" data-en="Mail from Altinn, EHF and email, routed to the right person">Post fra Altinn, EHF og e-post, rutet til rett person</small>
      </div>
      <div class="livecard livecard--next">
        <b data-nb="Ditt prosjekt?" data-en="Your project?">Ditt prosjekt?</b>
        <a href={project} data-umami-event="cta-click" data-umami-event-location="livecard" data-umami-event-label="pris-og-plan">Be om pris og plan</a>
      </div>
    </div>
  </div>
</section>
