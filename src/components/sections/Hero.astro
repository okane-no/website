---
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-blue-950 via-blue-900 to-violet-900 text-white pt-16">
  <!-- Decorative blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full bg-blue-500/10 blur-3xl"></div>
    <div class="absolute bottom-0 -left-40 w-[600px] h-[600px] rounded-full bg-violet-600/10 blur-3xl"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 36px 36px;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 xl:gap-16 items-center">
      <!-- Left: Copy -->
      <div>
        <!-- Live badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-sm text-blue-100 mb-7">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
          </span>
          Vipps og Klarna klar fra dag én
        </div>

        <h1 class="text-5xl lg:text-6xl xl:text-[4.25rem] font-bold tracking-tight leading-[1.08] mb-6">
          Bygg din<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 via-cyan-300 to-violet-300">
            drømmbutikk
          </span><br />
          på minutter
        </h1>

        <p class="text-lg md:text-xl text-blue-100/90 mb-8 leading-relaxed max-w-[480px]">
          Alt du trenger for norsk e-handel på ett sted. Ingen koding, ingen kompromisser — bare resultater.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 mb-10">
          <a
            href="#priser"
            class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-blue-900 font-semibold rounded-xl hover:bg-blue-50 transition-all shadow-xl shadow-blue-950/30 text-base"
          >
            Start gratis i 30 dager
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href="#demo"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl border border-white/20 hover:border-white/30 transition-all text-base"
          >
            <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
            Se demo
          </a>
        </div>

        <!-- Trust list -->
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-blue-200">
          {['Ingen kredittkort nødvendig', 'Norsk support', 'GDPR-sikret', 'Ingen binding'].map((item) => (
            <li class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-green-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: Product mockup -->
      <div class="relative hidden lg:block">
        <!-- Glow -->
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/20 to-violet-500/20 rounded-3xl blur-2xl scale-95"></div>

        <!-- Browser window -->
        <div class="relative bg-slate-900/80 backdrop-blur-sm border border-white/10 rounded-2xl shadow-2xl overflow-hidden">
          <!-- Chrome bar -->
          <div class="flex items-center gap-2.5 px-4 py-3 bg-slate-800/60 border-b border-white/10">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
            </div>
            <div class="flex-1 bg-slate-700/60 rounded-md px-3 py-1.5 text-xs text-slate-400 font-mono mx-2">
              minbutikk.okane.no
            </div>
            <div class="w-8 h-5 bg-slate-700/60 rounded"></div>
          </div>

          <!-- Shop UI mockup -->
          <div class="p-5">
            <!-- Shop header bar -->
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
              <div class="h-4 bg-white/25 rounded w-24"></div>
              <div class="flex items-center gap-2">
                <div class="h-7 w-24 bg-slate-700/80 rounded-lg flex items-center px-2.5 gap-1.5">
                  <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                  <div class="h-2 bg-slate-600 rounded w-10"></div>
                </div>
                <div class="h-7 w-7 bg-slate-700/80 rounded-lg flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                </div>
              </div>
            </div>

            <!-- Category bar -->
            <div class="flex gap-2 mb-4 overflow-hidden">
              {['Alle', 'Klær', 'Sko', 'Sport', 'Hjem'].map((cat, i) => (
                <div class={`px-3 py-1.5 rounded-lg text-xs font-medium flex-shrink-0 ${i === 0 ? 'bg-blue-600 text-white' : 'bg-white/5 text-slate-400'}`}>
                  {cat}
                </div>
              ))}
            </div>

            <!-- Product grid -->
            <div class="grid grid-cols-3 gap-2.5 mb-3">
              {[
                { price: '299 kr', badge: 'Ny', color: 'from-blue-500/20 to-blue-400/10' },
                { price: '849 kr', badge: 'Salg', color: 'from-violet-500/20 to-violet-400/10' },
                { price: '149 kr', badge: '', color: 'from-slate-600/30 to-slate-500/20' },
                { price: '1 299 kr', badge: '', color: 'from-emerald-500/20 to-emerald-400/10' },
                { price: '499 kr', badge: 'Hit', color: 'from-orange-500/20 to-orange-400/10' },
                { price: '199 kr', badge: '', color: 'from-pink-500/20 to-pink-400/10' },
              ].map(({ price, badge, color }) => (
                <div class="bg-white/5 rounded-xl overflow-hidden group cursor-pointer hover:bg-white/10 transition-colors">
                  <div class={`relative h-20 bg-gradient-to-br ${color} flex items-center justify-center`}>
                    {badge && (
                      <span class={`absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded text-[9px] font-bold text-white ${badge === 'Salg' ? 'bg-red-500' : badge === 'Ny' ? 'bg-green-500' : 'bg-blue-500'}`}>
                        {badge}
                      </span>
                    )}
                    <svg class="w-7 h-7 text-white/10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" /></svg>
                  </div>
                  <div class="p-2">
                    <div class="h-2.5 bg-white/20 rounded w-3/4 mb-1.5"></div>
                    <div class="text-[10px] text-blue-200 font-semibold">{price}</div>
                    <div class="mt-2 h-5 bg-blue-600/40 hover:bg-blue-600/60 rounded-md text-[8px] text-blue-200 flex items-center justify-center transition-colors">
                      + Handlekurv
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Live order notification -->
            <div class="flex items-center gap-2.5 p-2.5 bg-green-500/10 border border-green-500/20 rounded-xl">
              <div class="w-7 h-7 bg-green-500/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div class="min-w-0">
                <div class="text-[11px] text-green-300 font-semibold">Ny bestilling via Vipps!</div>
                <div class="text-[10px] text-green-400/70 truncate">Kari Olsen · 849 kr · Nå nettopp</div>
              </div>
              <div class="ml-auto flex-shrink-0 w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            </div>
          </div>
        </div>

        <!-- Floating stats card -->
        <div class="absolute -bottom-4 -left-8 bg-white rounded-xl shadow-xl border border-slate-100 p-3 flex items-center gap-3">
          <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
          </div>
          <div>
            <div class="text-xs text-slate-500">Omsetning i dag</div>
            <div class="text-sm font-bold text-slate-900">+14 832 kr</div>
          </div>
        </div>

        <!-- Floating rating card -->
        <div class="absolute -top-4 -right-4 bg-white rounded-xl shadow-xl border border-slate-100 p-3">
          <div class="flex items-center gap-1 mb-0.5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-3.5 h-3.5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <div class="text-xs font-semibold text-slate-900">4.9/5 · 500+ butikker</div>
        </div>
      </div>
    </div>
  </div>
</section>
