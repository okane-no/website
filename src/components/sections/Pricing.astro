---
const plans = [
  {
    name: 'Starter',
    price: { monthly: 199, annual: 166 },
    description: 'For deg som er ny på nett eller vil teste e-handel.',
    cta: 'Start gratis',
    ctaHref: '#',
    highlight: false,
    features: [
      'Opptil 200 produkter',
      'Vipps og Klarna',
      'Eget domene',
      'SSL-sertifikat inkludert',
      'Grunnleggende SEO',
      'E-post support',
      '3 designmaler',
      '2 GB medialagring',
    ],
    notIncluded: ['Regnskap-integrasjon', 'WMS & lagerstyring', 'B2B-handel'],
  },
  {
    name: 'Vekst',
    price: { monthly: 499, annual: 415 },
    description: 'For voksende butikker som vil ha mer av alt.',
    cta: 'Start gratis',
    ctaHref: '#',
    highlight: true,
    badge: 'Mest populær',
    features: [
      'Ubegrenset produkter',
      'Alt i Starter, pluss:',
      'Visma, Tripletex og Fiken',
      'WMS & lagerstyring',
      'Avansert SEO og analytics',
      'Chat- og telefonsupport',
      'Alle designmaler',
      '20 GB medialagring',
      'Forlatte handlekurver',
      'Rabattkoder og gavekort',
    ],
    notIncluded: ['B2B-handel og markedsplass'],
  },
  {
    name: 'Enterprise',
    price: { monthly: null, annual: null },
    description: 'For større bedrifter med spesielle behov.',
    cta: 'Kontakt oss',
    ctaHref: 'mailto:hei@okane.no',
    highlight: false,
    features: [
      'Alt i Vekst, pluss:',
      'B2B-handel og markedsplass',
      'Tilpasset design og kode',
      'Dedikert kundeansvarlig',
      'SLA-avtale (99.9% oppetid)',
      'SSO og avansert tilgangsstyring',
      'Ubegrenset medialagring',
      'Prioritert support & onboarding',
      'API-tilgang og webhooks',
      'Egne integrasjoner',
    ],
    notIncluded: [],
  },
];
---

<section id="priser" class="py-20 md:py-28 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-6">
      <span class="inline-block px-3 py-1 text-sm font-semibold text-blue-700 bg-blue-100 rounded-full mb-4">Priser</span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 tracking-tight">
        Transparente priser,<br />
        <span class="text-blue-600">ingen overraskelser</span>
      </h2>
      <p class="text-lg text-slate-500 max-w-xl mx-auto mb-8">
        Start gratis i 30 dager. Ingen kredittkort nødvendig, ingen binding.
      </p>

      <!-- Billing toggle -->
      <div class="inline-flex items-center gap-3 p-1 bg-white rounded-xl border border-slate-200 shadow-sm" id="billing-toggle">
        <button
          class="px-4 py-2 text-sm font-semibold rounded-lg transition-all billing-btn active bg-blue-600 text-white shadow-sm"
          data-period="monthly"
        >
          Månedlig
        </button>
        <button
          class="px-4 py-2 text-sm font-semibold rounded-lg transition-all billing-btn text-slate-600 hover:text-slate-900"
          data-period="annual"
        >
          Årlig
          <span class="ml-1.5 px-1.5 py-0.5 text-xs bg-green-100 text-green-700 rounded-full font-medium">Spar 2 mnd</span>
        </button>
      </div>
    </div>

    <!-- Pricing cards -->
    <div class="grid lg:grid-cols-3 gap-6 mt-10">
      {plans.map(({ name, price, description, cta, ctaHref, highlight, badge, features, notIncluded }) => (
        <div class={`relative flex flex-col rounded-2xl p-7 md:p-8 border-2 transition-all ${
          highlight
            ? 'bg-gradient-to-b from-blue-950 to-blue-900 border-blue-800 shadow-2xl shadow-blue-900/30 scale-[1.02]'
            : 'bg-white border-slate-200 hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/60'
        }`}>
          {badge && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
              <span class="px-4 py-1 bg-gradient-to-r from-blue-500 to-violet-500 text-white text-xs font-bold rounded-full shadow-lg shadow-blue-500/30">
                {badge}
              </span>
            </div>
          )}

          <div class="mb-6">
            <h3 class={`text-xl font-bold mb-1 ${highlight ? 'text-white' : 'text-slate-900'}`}>{name}</h3>
            <p class={`text-sm ${highlight ? 'text-blue-200' : 'text-slate-500'}`}>{description}</p>
          </div>

          <div class="mb-6">
            {price.monthly ? (
              <div>
                <div class={`flex items-end gap-1 ${highlight ? 'text-white' : 'text-slate-900'}`}>
                  <span class="text-4xl font-bold price-display" data-monthly={price.monthly} data-annual={price.annual}>
                    {price.monthly}
                  </span>
                  <span class={`text-lg mb-1 ${highlight ? 'text-blue-200' : 'text-slate-400'}`}>kr/mnd</span>
                </div>
                <p class={`text-xs mt-1 ${highlight ? 'text-blue-300' : 'text-slate-400'}`}>
                  Faktureres <span class="billing-period">månedlig</span>
                </p>
              </div>
            ) : (
              <div>
                <div class={`text-3xl font-bold ${highlight ? 'text-white' : 'text-slate-900'}`}>Tilbud</div>
                <p class={`text-sm mt-1 ${highlight ? 'text-blue-200' : 'text-slate-500'}`}>Skreddersydd pris</p>
              </div>
            )}
          </div>

          <a
            href={ctaHref}
            class={`flex items-center justify-center gap-2 w-full py-3 px-6 rounded-xl font-semibold text-sm mb-7 transition-all ${
              highlight
                ? 'bg-white text-blue-700 hover:bg-blue-50 shadow-lg shadow-blue-900/20'
                : 'bg-blue-600 text-white hover:bg-blue-700 shadow-sm shadow-blue-600/20'
            }`}
          >
            {cta}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>

          <ul class="space-y-2.5 flex-1">
            {features.map((feature, i) => (
              <li class={`flex items-start gap-2 text-sm ${highlight ? 'text-blue-100' : 'text-slate-600'}`}>
                <svg class={`w-4 h-4 mt-0.5 flex-shrink-0 ${i === 1 && name !== 'Starter' ? (highlight ? 'text-blue-400' : 'text-slate-400') : (highlight ? 'text-blue-300' : 'text-blue-500')}`}
                     fill={i === 1 && name !== 'Starter' ? 'none' : 'currentColor'} viewBox="0 0 20 20">
                  {i === 1 && name !== 'Starter'
                    ? <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    : <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  }
                </svg>
                {feature}
              </li>
            ))}
            {notIncluded.map(feature => (
              <li class={`flex items-start gap-2 text-sm ${highlight ? 'text-blue-300/50' : 'text-slate-300'} line-through`}>
                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Social proof -->
    <p class="text-center text-sm text-slate-500 mt-8">
      ✓ 30 dager gratis prøveperiode &nbsp;·&nbsp; ✓ Ingen kredittkort &nbsp;·&nbsp; ✓ Avbryt når som helst
    </p>
  </div>
</section>

<script>
  const toggle = document.getElementById('billing-toggle');
  const buttons = toggle?.querySelectorAll('.billing-btn');
  const prices = document.querySelectorAll('.price-display');
  const periods = document.querySelectorAll('.billing-period');
  let current = 'monthly';

  buttons?.forEach(btn => {
    btn.addEventListener('click', () => {
      const period = (btn as HTMLElement).dataset.period!;
      if (period === current) return;
      current = period;

      buttons.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.classList.toggle('bg-blue-600', b === btn);
        b.classList.toggle('text-white', b === btn);
        b.classList.toggle('shadow-sm', b === btn);
        b.classList.toggle('text-slate-600', b !== btn);
      });

      prices.forEach(el => {
        const price = (el as HTMLElement).dataset[period === 'monthly' ? 'monthly' : 'annual'];
        if (price) el.textContent = price;
      });

      periods.forEach(el => {
        el.textContent = period === 'monthly' ? 'månedlig' : 'årlig';
      });
    });
  });
</script>
