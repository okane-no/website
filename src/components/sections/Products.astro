---
---

<section class="block" id="produkter">
  <div class="container">
    <header class="block__header reveal">
      <div class="block__eyebrow" data-nb="Produkter" data-en="Products">Produkter</div>
      <div class="block__sub-wrap">
        <h2 class="block__title" data-nb="Vi bygger også vårt eget." data-en="We build our own, too.">Vi bygger også vårt eget.</h2>
        <p class="block__sub" data-nb="To produkter i aktiv drift. De holder håndverket vårt ærlig, og de kan bli dine." data-en="Two products in active service. They keep our craft honest, and they're available for yours.">
          To produkter i aktiv drift. De holder håndverket vårt ærlig, og de kan bli dine.
        </p>
      </div>
    </header>

    <!-- Product 1: Okane Commerce -->
    <div class="product reveal">
      <div class="product__head">
        <div class="product__name">
          <span class="pillar__num">01</span>
          <h3>Okane Commerce</h3>
        </div>
        <p class="product__desc" data-nb="Netthandelsplattform for norske merkevarer. Nettbutikk, kasse og lager i ett system, med Vipps, Klarna, frakt og regnskap ferdig integrert." data-en="An e-commerce platform for Norwegian brands. Storefront, point of sale and inventory in one system, with Vipps, Klarna, shipping and accounting built in.">
          Netthandelsplattform for norske merkevarer. Nettbutikk, kasse og lager i ett system, med Vipps, Klarna, frakt og regnskap ferdig integrert.
        </p>
      </div>

      <div class="hero__device">
        <div class="hero__device-inner">
          <div class="device__side">
            <div class="device__brand">
              <div class="topnav__logo">N</div>
              <b>Northwind</b>
            </div>
            <nav class="device__nav">
              <a href="#" class="is-active" data-nb="Oversikt" data-en="Overview">Oversikt</a>
              <a href="#" data-nb="Ordrer" data-en="Orders">Ordrer</a>
              <a href="#" data-nb="Produkter" data-en="Products">Produkter</a>
              <a href="#" data-nb="Kunder" data-en="Customers">Kunder</a>
              <a href="#" data-nb="Lager" data-en="Inventory">Lager</a>
              <a href="#" data-nb="Kasse" data-en="POS">Kasse</a>
              <a href="#" data-nb="Analyse" data-en="Analytics">Analyse</a>
            </nav>
          </div>

          <div class="device__main">
            <div class="device__head">
              <div>
                <h4 data-nb="I dag" data-en="Today">I dag</h4>
                <div class="muted" data-nb="Onsdag, 29. april 2026" data-en="Wednesday, 29 April 2026">Onsdag, 29. april 2026</div>
              </div>
              <div class="row gap-2">
                <button class="btn btn--secondary btn--sm" data-nb="Eksporter" data-en="Export">Eksporter</button>
                <button class="btn btn--primary btn--sm" data-nb="+ Nytt produkt" data-en="+ New product">+ Nytt produkt</button>
              </div>
            </div>

            <div class="device__stats">
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Omsetning" data-en="Revenue">Omsetning</div>
                <div class="device__stat-value tabular">kr 124 080</div>
                <div class="device__stat-delta up">▲ 8,2% <span data-nb="mot i går" data-en="vs yesterday">mot i går</span></div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Ordrer" data-en="Orders">Ordrer</div>
                <div class="device__stat-value tabular">84</div>
                <div class="device__stat-delta up">▲ 4 <span data-nb="mot i går" data-en="vs yesterday">mot i går</span></div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label">AOV</div>
                <div class="device__stat-value tabular">kr 1 477</div>
                <div class="device__stat-delta down">▼ 1,1%</div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Konvertering" data-en="Conversion">Konvertering</div>
                <div class="device__stat-value tabular">3,4%</div>
                <div class="device__stat-delta up">▲ 0,2 pp</div>
              </div>
            </div>

            <div class="device__chart">
              <svg viewBox="0 0 600 64" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="chart-grad" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent-bg)" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="var(--accent-bg)" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,48 L40,42 L80,46 L120,38 L160,40 L200,30 L240,34 L280,22 L320,28 L360,18 L400,24 L440,14 L480,20 L520,10 L560,16 L600,8" fill="none" stroke="var(--accent-bg)" stroke-width="1.6"/>
                <path d="M0,48 L40,42 L80,46 L120,38 L160,40 L200,30 L240,34 L280,22 L320,28 L360,18 L400,24 L440,14 L480,20 L520,10 L560,16 L600,8 L600,64 L0,64 Z" fill="url(#chart-grad)"/>
              </svg>
            </div>

            <div class="table-wrap">
              <table class="table tabular">
                <thead>
                  <tr>
                    <th data-nb="Ordre" data-en="Order">Ordre</th>
                    <th data-nb="Kunde" data-en="Customer">Kunde</th>
                    <th data-nb="Status" data-en="Status">Status</th>
                    <th class="num" data-nb="Sum" data-en="Total">Sum</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span class="mono">#ORD-7G2A</span></td>
                    <td>Elin Larsen</td>
                    <td><span class="badge badge--success"><span class="dot"></span><span data-nb="Betalt" data-en="Paid">Betalt</span></span></td>
                    <td class="num">kr 2 480</td>
                  </tr>
                  <tr>
                    <td><span class="mono">#ORD-7G29</span></td>
                    <td>Jonas Müller</td>
                    <td><span class="badge badge--warning"><span class="dot"></span><span data-nb="Venter" data-en="Pending">Venter</span></span></td>
                    <td class="num">kr 14 205</td>
                  </tr>
                  <tr>
                    <td><span class="mono">#ORD-7G27</span></td>
                    <td>Saoirse Hayes</td>
                    <td><span class="badge badge--info"><span class="dot"></span><span data-nb="Sendt" data-en="Shipped">Sendt</span></span></td>
                    <td class="num">kr 740</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Product 2: Digital Mailroom -->
    <div class="product reveal">
      <div class="product__head">
        <div class="product__name">
          <span class="pillar__num">02</span>
          <h3>Digital Mailroom</h3>
        </div>
        <p class="product__desc" data-nb="Digitalt postmottak for virksomheten. Inngående post fra Altinn, EHF og e-post samles i én innboks, sorteres og rutes automatisk til rett person." data-en="A digital mailroom for your organisation. Inbound mail from Altinn, EHF and email lands in one inbox and is automatically classified and routed to the right person.">
          Digitalt postmottak for virksomheten. Inngående post fra Altinn, EHF og e-post samles i én innboks, sorteres og rutes automatisk til rett person.
        </p>
      </div>

      <div class="preview">
        <div class="preview__bar">
          <div class="lights"><span></span><span></span><span></span></div>
          <div class="preview__url">https://mailroom.okane.no</div>
        </div>
        <div class="preview__body preview__body--flush">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th data-nb="Dokument" data-en="Document">Dokument</th>
                  <th data-nb="Avsender" data-en="Sender">Avsender</th>
                  <th data-nb="Kanal" data-en="Channel">Kanal</th>
                  <th data-nb="Status" data-en="Status">Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td data-nb="Skattemelding 2025" data-en="Tax return 2025">Skattemelding 2025</td>
                  <td>Skatteetaten</td>
                  <td><span class="mono">Altinn</span></td>
                  <td><span class="badge badge--info"><span class="dot"></span><span data-nb="Rutet til økonomi" data-en="Routed to finance">Rutet til økonomi</span></span></td>
                </tr>
                <tr>
                  <td data-nb="Faktura #B-4821" data-en="Invoice #B-4821">Faktura #B-4821</td>
                  <td>Bring</td>
                  <td><span class="mono">EHF</span></td>
                  <td><span class="badge badge--success"><span class="dot"></span><span data-nb="Arkivert" data-en="Archived">Arkivert</span></span></td>
                </tr>
                <tr>
                  <td data-nb="Signert kontrakt" data-en="Signed contract">Signert kontrakt</td>
                  <td>Nordvik Eiendom</td>
                  <td><span class="mono" data-nb="E-post" data-en="Email">E-post</span></td>
                  <td><span class="badge badge--warning"><span class="dot"></span><span data-nb="Til godkjenning" data-en="Awaiting approval">Til godkjenning</span></span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="subproduct">
        <div class="subproduct__body">
          <h4>
            Altinn Downloader
            <span class="badge badge--info"><span class="dot"></span><span data-nb="Standard subprodukt" data-en="Standard sub-product">Standard subprodukt</span></span>
          </h4>
          <p data-nb="Standard subprodukt av Digital Mailroom. Overvåker Altinn-innboksen, laster automatisk ned nye meldinger og vedlegg, og arkiverer dem der dere vil ha dem." data-en="A standard sub-product of Digital Mailroom. Watches your Altinn inbox, automatically downloads new messages and attachments, and archives them where you want them.">
            Standard subprodukt av Digital Mailroom. Overvåker Altinn-innboksen, laster automatisk ned nye meldinger og vedlegg, og arkiverer dem der dere vil ha dem.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
