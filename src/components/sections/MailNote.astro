---
// The line under a button that opens an email: says what happens, shows the address and lets
// people copy it when no mail app is set up.
import { EMAIL } from '~/lib/contact';

interface Props {
  location: string;
  lead?: string;
}

const { location, lead } = Astro.props;
---

<p class="mailnote">
  {lead && <>{lead} </>}Åpner e-post til <span class="mailnote__addr">{EMAIL}</span>. Svar innen en arbeidsdag.
  <button
    type="button"
    class="mailnote__copy"
    data-copy={EMAIL}
    data-umami-event="copy-email"
    data-umami-event-location={location}
  >Kopier adresse</button>
</p>

<script>
  document.querySelectorAll<HTMLButtonElement>('.mailnote__copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // No clipboard access: select the address so it can be copied by hand
        const addr = btn.parentElement?.querySelector('.mailnote__addr');
        if (addr) window.getSelection()?.selectAllChildren(addr);
        return;
      }
      btn.textContent = 'Kopiert';
      setTimeout(() => (btn.textContent = 'Kopier adresse'), 2000);
    });
  });
</script>
