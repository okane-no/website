---
const features = [
  { label: 'Norsk Vipps-integrasjon', okane: true, mystore: true, shopify: false },
  { label: 'Visma / Tripletex / Fiken', okane: true, mystore: false, shopify: false },
  { label: 'WMS & lagerstyring', okane: true, mystore: false, shopify: false },
  { label: 'B2B-handel innebygd', okane: true, mystore: false, shopify: false, shopifyNote: 'App (ekstra kost)' },
  { label: 'Norsk support', okane: true, mystore: true, shopify: false, shopifyNote: 'Ikke på norsk' },
  { label: 'Ubegrenset produkter fra kr 499', okane: true, mystore: false, shopify: false },
  { label: 'GDPR-data i EU', okane: true, mystore: true, shopify: false, shopifyNote: 'USA' },
  { label: 'Åpen kildekode (Vendure)', okane: true, mystore: false, shopify: false },
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="inline-block px-3 py-1 text-sm font-semibold text-slate-700 bg-slate-100 rounded-full mb-4">Sammenligning</span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 tracking-tight">
        Hvorfor velge Okane<br />
        <span class="text-blue-600">fremfor alternativene?</span>
      </h2>
    </div>

    <!-- Comparison table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="text-left px-6 py-4 font-semibold text-slate-700 w-1/2">Funksjon</th>
            <th class="text-center px-4 py-4 w-[16.67%]">
              <div class="flex flex-col items-center gap-1">
                <span class="text-xs font-medium text-slate-500">Okane</span>
                <span class="px-2 py-0.5 bg-blue-600 text-white text-xs font-bold rounded-full">Anbefalt</span>
              </div>
            </th>
            <th class="text-center px-4 py-4 text-xs font-medium text-slate-500 w-[16.67%]">MyStore</th>
            <th class="text-center px-4 py-4 text-xs font-medium text-slate-500 w-[16.67%]">Shopify</th>
          </tr>
        </thead>
        <tbody>
          {features.map(({ label, okane, mystore, shopify, shopifyNote }, i) => (
            <tr class={`border-b border-slate-100 hover:bg-slate-50/50 transition-colors ${i % 2 === 0 ? '' : 'bg-slate-50/30'}`}>
              <td class="px-6 py-3.5 text-slate-700 font-medium">{label}</td>
              <td class="text-center px-4 py-3.5">
                {okane
                  ? <svg class="w-5 h-5 text-blue-600 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  : <svg class="w-5 h-5 text-slate-300 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                }
              </td>
              <td class="text-center px-4 py-3.5">
                {mystore
                  ? <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  : <svg class="w-5 h-5 text-slate-300 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                }
              </td>
              <td class="text-center px-4 py-3.5">
                {shopify
                  ? <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  : shopifyNote
                    ? <span class="text-xs text-slate-400 italic">{shopifyNote}</span>
                    : <svg class="w-5 h-5 text-slate-300 mx-auto" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                }
              </td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="bg-slate-50">
            <td class="px-6 py-4 text-sm font-semibold text-slate-700">Startpris</td>
            <td class="text-center px-4 py-4">
              <span class="text-blue-700 font-bold">199 kr/mnd</span>
            </td>
            <td class="text-center px-4 py-4 text-slate-600 text-sm">Fra 249 kr/mnd</td>
            <td class="text-center px-4 py-4 text-slate-600 text-sm">Fra ~290 kr/mnd</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <p class="text-center text-xs text-slate-400 mt-4">
      * Sammenligning er basert på tilgjengelig offentlig informasjon per april 2025. Priser kan variere.
    </p>
  </div>
</section>
