---
const steps = [
  {
    number: '01',
    title: 'Opprett konto gratis',
    description: 'Registrer deg på 2 minutter — ingen kredittkort nødvendig. Du får umiddelbar tilgang til alle funksjoner i 30 dager.',
    details: ['Velg butikknavn og bransje', 'Last opp logo og velg design', 'Ferdig på under 2 minutter'],
    color: 'text-blue-600',
    borderColor: 'border-blue-200',
    bgColor: 'bg-blue-50',
  },
  {
    number: '02',
    title: 'Tilpass butikken din',
    description: 'Legg til produkter, sett priser og velg design med vår enkle drag-og-slipp editor. Ingen koding nødvendig — noensinne.',
    details: ['Last opp produkter med CSV eller manuelt', 'Koble til Vipps og Klarna med ett klikk', 'Synkroniser regnskapet automatisk'],
    color: 'text-violet-600',
    borderColor: 'border-violet-200',
    bgColor: 'bg-violet-50',
  },
  {
    number: '03',
    title: 'Gå live og selg!',
    description: 'Publiser butikken din, knytt til ditt domene og begynn å ta imot bestillinger. Vi hjelper deg hvert steg på veien.',
    details: ['Eget domene eller subdomain', 'SSL og sikkerhet inkludert', 'Norsk support ved behov'],
    color: 'text-emerald-600',
    borderColor: 'border-emerald-200',
    bgColor: 'bg-emerald-50',
  },
];
---

<section id="demo" class="py-20 md:py-28 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3 py-1 text-sm font-semibold text-violet-700 bg-violet-100 rounded-full mb-4">Slik fungerer det</span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 tracking-tight">
        Kom i gang på <span class="text-violet-600">minutter</span>
      </h2>
      <p class="text-lg text-slate-500 max-w-xl mx-auto">
        Tre enkle steg fra idé til nettbutikk som faktisk selger.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid lg:grid-cols-3 gap-8 relative">
      <!-- Connector line (desktop) -->
      <div class="hidden lg:block absolute top-14 left-[calc(33.33%-16px)] right-[calc(33.33%-16px)] h-0.5 bg-gradient-to-r from-blue-200 via-violet-200 to-emerald-200 z-0"></div>

      {steps.map(({ number, title, description, details, color, borderColor, bgColor }, i) => (
        <div class="relative">
          <!-- Step number bubble -->
          <div class={`relative z-10 w-14 h-14 ${bgColor} border-2 ${borderColor} rounded-2xl flex items-center justify-center mb-6 shadow-sm`}>
            <span class={`text-lg font-bold ${color}`}>{number}</span>
          </div>

          <h3 class="text-xl font-bold text-slate-900 mb-3">{title}</h3>
          <p class="text-slate-500 mb-5 leading-relaxed">{description}</p>

          <ul class="space-y-2">
            {details.map(detail => (
              <li class="flex items-center gap-2 text-sm text-slate-600">
                <svg class={`w-4 h-4 ${color} flex-shrink-0`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                {detail}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom box -->
    <div class="mt-16 p-8 md:p-10 bg-gradient-to-br from-blue-600 to-violet-700 rounded-3xl text-white text-center">
      <h3 class="text-2xl md:text-3xl font-bold mb-3">Klar til å komme i gang?</h3>
      <p class="text-blue-100 mb-6 text-lg">Start din gratis prøveperiode — ingen kredittkort nødvendig.</p>
      <a href="#priser" class="inline-flex items-center gap-2 px-8 py-3.5 bg-white text-blue-700 font-semibold rounded-xl hover:bg-blue-50 transition-colors shadow-lg shadow-blue-900/20 text-base">
        Start gratis i 30 dager
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
