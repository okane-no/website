---
---

<section class="block">
  <div class="container">
    <header class="block__header reveal">
      <div class="block__eyebrow" data-nb="Butikkfront" data-en="Storefront">Butikkfront</div>
      <div class="block__sub-wrap">
        <h2 class="block__title" data-nb="En lekker butikk, på en ettermiddag." data-en="A beautiful storefront, in an afternoon.">En lekker butikk, på en ettermiddag.</h2>
        <p class="block__sub" data-nb="Beskriv merkevaren, last opp produktene, så genererer AI et komplett design med tekst, bilder og struktur. Du justerer det du vil, vi gjør resten." data-en="Describe your brand, upload your products, and AI generates a complete design with copy, imagery and structure. You tweak what you want, we handle the rest.">
          Beskriv merkevaren, last opp produktene, så genererer AI et komplett design med tekst, bilder og struktur. Du justerer det du vil, vi gjør resten.
        </p>
      </div>
    </header>

    <div class="preview reveal">
      <div class="preview__bar">
        <div class="lights"><span></span><span></span><span></span></div>
        <div class="preview__url">https://shop.northwind.no</div>
      </div>
      <div class="preview__body">
        <div class="sf-hero">
          <div>
            <div class="eyebrow" data-nb="Vår 26 · Ny kolleksjon" data-en="Spring 26 · New collection">Vår 26 · Ny kolleksjon</div>
            <h4 style="margin-top:var(--space-3);" data-nb="Laget for å brukes,&lt;br&gt;ikke vises frem." data-en="Made to be worn,&lt;br&gt;not displayed.">Laget for å brukes,<br>ikke vises frem.</h4>
            <p data-nb="Lin, ull og av og til en gjennomtenkt detalj. Designet i Oslo, sydd i Portugal, sendt med ro." data-en="Linen, wool, and the occasional considered detail. Designed in Oslo, sewn in Portugal, shipped quietly.">Lin, ull og av og til en gjennomtenkt detalj. Designet i Oslo, sydd i Portugal, sendt med ro.</p>
            <div class="row gap-3" style="margin-top:var(--space-6);">
              <button class="btn btn--primary" data-nb="Handle kolleksjonen" data-en="Shop the collection">Handle kolleksjonen</button>
              <button class="btn btn--ghost" data-nb="Les journalen →" data-en="Read the journal →">Les journalen →</button>
            </div>
          </div>
          <div class="sf-hero__img"></div>
        </div>

        <div class="sf-products">
          <div class="sf-product">
            <div class="sf-product__img"></div>
            <div class="sf-product__name" data-nb="Linskjorte, Sand" data-en="Linen Shirt, Sand">Linskjorte, Sand</div>
            <div class="sf-product__price mono">kr 1 480</div>
          </div>
          <div class="sf-product">
            <div class="sf-product__img"></div>
            <div class="sf-product__name" data-nb="Ullbukse, Blekk" data-en="Wool Trouser, Ink">Ullbukse, Blekk</div>
            <div class="sf-product__price mono">kr 2 200</div>
          </div>
          <div class="sf-product">
            <div class="sf-product__img"></div>
            <div class="sf-product__name" data-nb="Kashmir-genser, Tåke" data-en="Cashmere Crew, Fog">Kashmir-genser, Tåke</div>
            <div class="sf-product__price mono">kr 2 850</div>
          </div>
          <div class="sf-product">
            <div class="sf-product__img"></div>
            <div class="sf-product__name" data-nb="Bomulls-T, Hvit" data-en="Cotton Tee, White">Bomulls-T, Hvit</div>
            <div class="sf-product__price mono">kr 480</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
