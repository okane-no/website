---
const testimonials = [
  {
    quote: 'Okane forandret måten vi selger på. Vi fikk nettbutikken opp på én dag og har økt nettomsetningen med 240% det første halvåret.',
    author: 'Lars Hansen',
    role: 'Daglig leder',
    company: 'Hansen Møbler AS',
    avatar: 'LH',
    avatarColor: 'bg-blue-600',
    stars: 5,
    highlight: 'økt omsetning med 240%',
  },
  {
    quote: 'Den norske supporten er det beste jeg har opplevd. De svarte på 4 minutter og løste problemet på under ett minutt. Finnes ikke bedre.',
    author: 'Kari Nilsen',
    role: 'Grunnlegger',
    company: 'Karis Naturkosmetikk',
    avatar: 'KN',
    avatarColor: 'bg-violet-600',
    stars: 5,
    highlight: 'beste norske support',
  },
  {
    quote: 'WMS-integrasjonen alene er verdt hele prisen. For første gang har vi full oversikt over lageret og slipper å selge produkter vi ikke har.',
    author: 'Thomas Berg',
    role: 'E-handelssjef',
    company: 'Berg Sport AS',
    avatar: 'TB',
    avatarColor: 'bg-emerald-600',
    stars: 5,
    highlight: 'full lagerkontroll',
  },
  {
    quote: 'Vi migrerte fra Shopify til Okane og angrer ikke ett sekund. Norske integrsjoner, lavere pris og mye bedre support — win-win-win.',
    author: 'Marte Johansen',
    role: 'Produktsjef',
    company: 'Hjem & Hytte',
    avatar: 'MJ',
    avatarColor: 'bg-orange-600',
    stars: 5,
    highlight: 'bedre enn Shopify',
  },
  {
    quote: 'Visma-integrasjonen sparer oss for 6-8 timer bokføring i måneden. Systemet synkroniserer automatisk alle ordre og fakturaer.',
    author: 'Andreas Christensen',
    role: 'Økonomiansvarlig',
    company: 'Christensen Vin',
    avatar: 'AC',
    avatarColor: 'bg-teal-600',
    stars: 5,
    highlight: '6-8 timer spart/mnd',
  },
  {
    quote: 'Som nybegynner var jeg redd for å sette opp nettbutikk. Med Okane hadde jeg alt klar på 45 minutter, og Vipps fungerte med én gang!',
    author: 'Silje Andersen',
    role: 'Selvstendig næringsdrivende',
    company: 'Siljes Strikkestue',
    avatar: 'SA',
    avatarColor: 'bg-pink-600',
    stars: 5,
    highlight: 'klar på 45 minutter',
  },
];
---

<section class="py-20 md:py-28 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <span class="inline-block px-3 py-1 text-sm font-semibold text-orange-700 bg-orange-100 rounded-full mb-4">Kundene sier</span>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-5 tracking-tight">
        Over 500 norske butikker<br />
        <span class="text-orange-500">elsker Okane</span>
      </h2>
      <div class="flex items-center justify-center gap-2">
        <div class="flex">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))}
        </div>
        <span class="font-semibold text-slate-900">4.9</span>
        <span class="text-slate-500 text-sm">basert på 500+ anmeldelser</span>
      </div>
    </div>

    <!-- Testimonial grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map(({ quote, author, role, company, avatar, avatarColor, stars, highlight }) => (
        <div class="flex flex-col p-6 md:p-7 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 hover:shadow-lg hover:shadow-slate-200/60 transition-all duration-300">
          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {Array.from({ length: stars }).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-slate-700 leading-relaxed flex-1 mb-5 text-sm md:text-base">
            "{quote}"
          </blockquote>

          <!-- Highlight badge -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-semibold mb-4 self-start">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            {highlight}
          </div>

          <!-- Author -->
          <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
            <div class={`w-10 h-10 ${avatarColor} rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0`}>
              {avatar}
            </div>
            <div>
              <div class="font-semibold text-slate-900 text-sm">{author}</div>
              <div class="text-xs text-slate-500">{role} · {company}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
