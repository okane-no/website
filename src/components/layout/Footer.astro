---
const currentYear = new Date().getFullYear();

const links = {
  produkt: [
    { text: 'Funksjoner', href: '#funksjoner' },
    { text: 'Priser', href: '#priser' },
    { text: 'Integrasjoner', href: '#integrasjoner' },
    { text: 'Changelog', href: '#' },
  ],
  losninger: [
    { text: 'B2C Nettbutikk', href: '#' },
    { text: 'B2B Handel', href: '#' },
    { text: 'Markedsplass', href: '#' },
    { text: 'WMS & Lager', href: '#' },
  ],
  ressurser: [
    { text: 'Dokumentasjon', href: '#' },
    { text: 'Blogg', href: '#' },
    { text: 'Kom i gang', href: '#' },
    { text: 'Statusside', href: '#' },
  ],
  selskap: [
    { text: 'Om oss', href: '#' },
    { text: 'Kontakt', href: '#' },
    { text: 'Personvern', href: '#' },
    { text: 'Vilkår', href: '#' },
  ],
};
---

<footer class="bg-slate-950 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 md:gap-12 pb-12 border-b border-slate-800">
      <!-- Brand col -->
      <div class="col-span-2">
        <a href="/" class="inline-flex items-center gap-2 mb-4 group">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-violet-600 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-widest text-white">OKANE</span>
        </a>
        <p class="text-sm leading-relaxed mb-6 max-w-xs">
          Norges smarteste netthandelsplattform. Bygget for norske bedrifter — med norske integrasjoner fra dag én.
        </p>
        <div class="flex gap-3">
          <a href="https://github.com/okane-no" aria-label="GitHub" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      {Object.entries(links).map(([category, items]) => (
        <div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
            {category === 'produkt' ? 'Produkt' : category === 'losninger' ? 'Løsninger' : category === 'ressurser' ? 'Ressurser' : 'Selskap'}
          </h3>
          <ul class="space-y-2.5">
            {items.map(link => (
              <li>
                <a href={link.href} class="text-sm hover:text-white transition-colors">{link.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm">
        &copy; {currentYear} Okane AS · Alle rettigheter forbeholdt
      </p>
      <div class="flex items-center gap-4 text-sm">
        <a href="#" class="hover:text-white transition-colors">Personvern</a>
        <a href="#" class="hover:text-white transition-colors">Vilkår</a>
        <a href="#" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
