        <a href="/#prosess" data-nb="Slik jobber vi" data-en="How we work">Slik jobber vi</a>
        <a href="/#faq" data-nb="Spørsmål og svar" data-en="FAQ">Spørsmål og svar</a>
        <a href="/#kontakt" data-nb="Kontakt" data-en="Contact">Kontakt</a>
        <a href="mailto:hei@okane.no" data-umami-event="cta-click" data-umami-event-location="footer" data-umami-event-label="e-post">hei@okane.no</a>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>© 2026 Okane AS</span>
        <a href="https://virksomhet.brreg.no/nb/oppslag/enheter/938401934" rel="noopener">Org.nr. 938 401 934</a>
        <span>Tønsberg</span>
