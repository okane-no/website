<footer>
  <div class="container">
    <div class="footer__top">
      <div>
        <a href="/" class="topnav__brand">
          <div class="topnav__logo">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="5"/>
              <line x1="6.4" y1="1.5" x2="6.4" y2="14.5"/>
              <line x1="9.6" y1="1.5" x2="9.6" y2="14.5"/>
            </svg>
          </div>
          Okane
        </a>
        <p class="footer__brand" data-nb="Vi bygger som om vi skal drifte det. Nettsider, netthandel, mobilapper, integrasjoner og AI-agenter." data-en="We build like we will run it. Websites, e-commerce, mobile apps, integrations and AI agents.">Vi bygger som om vi skal drifte det. Nettsider, netthandel, mobilapper, integrasjoner og AI-agenter.</p>
      </div>

      <div class="footer__col">
        <div class="footer__col-title" data-nb="Tjenester" data-en="Services">Tjenester</div>
        <a href="/nettsider" data-nb="Nettsider" data-en="Websites">Nettsider</a>
        <a href="/netthandel" data-nb="Netthandel" data-en="E-commerce">Netthandel</a>
        <a href="/mobilapper" data-nb="Mobilapper" data-en="Mobile apps">Mobilapper</a>
        <a href="/integrasjoner" data-nb="Integrasjoner" data-en="Integrations">Integrasjoner</a>
        <a href="/ai-agenter" data-nb="AI-agenter" data-en="AI agents">AI-agenter</a>
