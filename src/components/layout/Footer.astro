      <div class="footer__col">
        <div class="footer__col-title" data-nb="Produkter" data-en="Products">Produkter</div>
        <a href="/commerce" data-umami-event="nav-product" data-umami-event-location="footer" data-umami-event-label="commerce">Okane Commerce</a>
        <a href="/mailroom" data-umami-event="nav-product" data-umami-event-location="footer" data-umami-event-label="mailroom">Digital Mailroom</a>
        <a href="/brage" data-umami-event="nav-product" data-umami-event-location="footer" data-umami-event-label="brage">Brage</a>
      </div>

      <div class="footer__col">
