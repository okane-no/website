---
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  // Share image under public/, 1200×630
  image?: string;
  imageAlt?: string;
  // Structured data for this page, added to the organisation's own
  schema?: Record<string, unknown>[];
  // Pages that shouldn't be in search yet
  noindex?: boolean;
}

const {
  title = 'Okane – IT-byrå i Vestfold for nett, apper og Altinn',
  description = 'Konsulenthus i Tønsberg som bygger nettsider, nettbutikker, apper og Altinn-integrasjoner, og drifter dem etterpå.',
  image = '/og/okane.png',
  imageAlt = 'Okane: Vi bygger som om vi skal drifte det.',
  schema = [],
  noindex = false,
} = Astro.props;

// Pages are served without a trailing slash (nginx redirects to that form), so the canonical matches the URL that answers
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const imageUrl = new URL(image, Astro.site);

// Who Okane is, on every page, so search engines and AI answers can tie the site to the registered company
const organisation = {
  '@type': 'Organization',
  '@id': 'https://okane.no/#org',
  name: 'Okane',
  legalName: 'Okane AS',
  url: 'https://okane.no/',
  logo: 'https://okane.no/og/logo.png',
  email: 'hei@okane.no',
  identifier: { '@type': 'PropertyValue', propertyID: 'Organisasjonsnummer', value: '938401934' },
  address: { '@type': 'PostalAddress', addressLocality: 'Tønsberg', addressRegion: 'Vestfold', addressCountry: 'NO' },
  areaServed: { '@type': 'Country', name: 'Norge' },
  knowsAbout: ['Altinn-integrasjon', 'Netthandel', 'Systemintegrasjon', 'AI-agenter', 'Nettsider', 'Mobilapper'],
  sameAs: ['https://virksomhet.brreg.no/nb/oppslag/enheter/938401934'],
};
const website = { '@type': 'WebSite', '@id': 'https://okane.no/#website', url: 'https://okane.no/', name: 'Okane', inLanguage: 'nb-NO', publisher: { '@id': 'https://okane.no/#org' } };
const graph = { '@context': 'https://schema.org', '@graph': [organisation, website, ...schema] };
---

<!doctype html>
<html lang="nb" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content="Okane" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="orcPxI47GSa-cRvY11tUe6iGg2IO_RPvnA1q95iEM3M" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..900;1,400..900&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <!-- Theme init: runs before paint to prevent FOUC -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('okane-theme');
        if (t) document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <!-- Self-hosted Umami (shared with Peakpower). Counts okane.no only, so local dev and previews stay out of the numbers. -->
    <script async defer src="https://analytics.marensiuspettersen.no/script.js" data-website-id="438a3f74-8d24-49ec-bdb4-beb11d728cb2" data-domains="okane.no"></script>
  </head>
  <body>
    <slot />

    <script is:inline>
      // Theme toggle
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-btn');
        var icon = document.getElementById('theme-icon');
        if (!btn) return;
        function setTheme(t) {
          root.setAttribute('data-theme', t);
          localStorage.setItem('okane-theme', t);
          if (icon) {
            icon.innerHTML = t === 'dark'
              ? '<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5 5.5 5.5 0 1 0 13.5 9.5z"/>'
              : '<path d="M8 1.5v1.2M8 13.3v1.2M2.46 2.46l.85.85M12.69 12.69l.85.85M1.5 8h1.2M13.3 8h1.2M2.46 13.54l.85-.85M12.69 3.31l.85-.85"/><circle cx="8" cy="8" r="3"/>';
          }
        }
        var stored = localStorage.getItem('okane-theme') || 'light';
        setTheme(stored);
        btn.addEventListener('click', function () {
          setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });
      })();

      // Language toggle
      (function () {
        var btns = document.querySelectorAll('.lang button');
        var stored = 'nb'; // Language toggle disabled: ignore any stored choice
        function apply(lang) {
          document.documentElement.setAttribute('lang', lang === 'nb' ? 'nb' : 'en');
          document.querySelectorAll('[data-nb]').forEach(function (el) {
            var v = el.getAttribute('data-' + lang);
            if (v == null) return;
            if (v.indexOf('<br>') !== -1 || v.indexOf('&lt;br&gt;') !== -1) {
              el.innerHTML = v.replace(/&lt;br&gt;/g, '<br>');
            } else {
              el.textContent = v;
            }
          });
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-lang') === lang ? 'true' : 'false');
          });
          localStorage.setItem('okane-lang', lang);
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () { apply(b.getAttribute('data-lang')); });
        });
        apply(stored);
      })();

      // Scroll reveal
      (function () {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('in'); });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
