---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Proof from '~/components/sections/Proof.astro';
import Process from '~/components/sections/Process.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CTA from '~/components/sections/CTA.astro';
import { mailto, prompts } from '~/lib/contact';
import spactForside from '~/assets/prosjekter/spact/forside.webp';

const contact = mailto('Nettsider', prompts.project);

const faq = [
  {
    q: 'Kan vi oppdatere nettsiden selv?',
    a: 'Ja. Dere får et publiseringsverktøy for tekst, bilder og nye sider, og vi viser dere hvordan det brukes før lansering.',
  },
  {
    q: 'Kan dere flytte innholdet fra den gamle siden?',
    a: 'Ja. Vi flytter tekst og bilder og setter opp videresendinger fra de gamle adressene, så lenker og søkeresultater fortsatt fører til riktig side.',
  },
  {
    q: 'Hvor lang tid tar det?',
    a: 'Noe kjører i et testmiljø fra første uke. Hvor lang tid resten tar, står i forslaget sammen med prisen.',
  },
  {
    q: 'Hva koster en nettside?',
    a: 'Det avhenger av antall sider, innhold og hva siden skal kobles til. Du får en fast pris etter et arbeidsmøte, før vi starter.',
  },
];
---

<Layout
  title="Nettsider for bedrifter, raske og synlige i søk · Okane"
  description="Raske, tilgjengelige nettsider for bedrifter, bygget for å bli funnet i søk og enkle å oppdatere selv. Vi blir med videre i drift."
  schema={[{"@type": "Service", "name": "Nettsider", "serviceType": "Utvikling av nettsider", "url": "https://okane.no/nettsider", "description": "Raske, tilgjengelige nettsider for bedrifter, enkle å oppdatere selv.", "provider": {"@id": "https://okane.no/#org"}, "areaServed": {"@type": "Country", "name": "Norge"}}]}
>
  <Header ctaLabel="Be om pris og plan" ctaHref="#kontakt" ctaEvent="pris-og-plan" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <a href="/#tjenester" data-nb="Tjenester" data-en="Services">Tjenester</a>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span>Nettsider du</span><br>
        <em>oppdaterer selv.</em>
      </h1>

      <p class="hero__sub">
        Vi lager struktur, tekst og design, bygger siden rask og lett å finne i søk, og viser dere hvordan dere publiserer selv. Når dere trenger mer, er vi fortsatt her.
      </p>

      <div class="hero__cta">
        <a href={contact} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="pris-og-plan">Be om pris og plan</a>
        <a href="/prosjekter" class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="se-prosjektene">Se prosjektene</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title">Bygget for å vare.</h2>
          <p class="block__sub">
            En nettside teamet ditt kan eie og oppdatere selv etter lansering.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4>Design og innhold</h4>
            <p>Struktur, tekst og uttrykk laget for merkevaren din.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>SEO og ytelse</h4>
            <p>Siden bygges for å lastes raskt og bli funnet i søk, og vi måler Core Web Vitals før lansering.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Enkel publisering</h4>
            <p>Dere oppdaterer tekst, bilder og sider selv, og opplæringen er med i prisen.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Universell utforming</h4>
            <p>Følger kravene til universell utforming fra første versjon.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Proof
    title="Spact samler innmelding, kalender og ligatabeller på ett sted."
    text="Medlems- og arrangementsplattform for Summoner's Pact, en forening for samlekortspill og brettspill. Nye medlemmer melder seg inn og betaler på siden, og arrangementer og ligatabeller ligger ved siden av."
    href="https://www.spact.no"
    label="Se spact.no"
    event="se-spact"
    image={spactForside}
    alt="Forsiden til spact.no"
  />

  <Process />

  <FAQ title="Spørsmål om nettsider." sub="Det vi oftest får spørsmål om før en ny nettside. Lurer du på noe annet, er det bare å spørre." items={faq} />

  <CTA
    title="Klar for en nettside dere styrer selv?"
    text="Send oss adressen til dagens nettside, så svarer vi med hva vi ville gjort annerledes og hva det vil koste."
    primary={{ label: 'Be om pris og plan', href: contact, event: 'pris-og-plan' }}
    secondary={{ label: 'Se prosjektene', href: '/prosjekter', event: 'se-prosjektene' }}
  />

  <Footer />
</Layout>
