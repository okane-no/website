---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
---

<Layout
  title="Nettsider · Okane"
  description="Raske, tilgjengelige nettsider som blir funnet i søk og er enkle å oppdatere selv."
>
  <Header />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <span data-nb="Tjeneste fra Okane" data-en="A service by Okane">Tjeneste fra Okane</span>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span data-nb="Nettsider," data-en="Websites,">Nettsider,</span><br>
        <em data-nb="som blir funnet." data-en="that get found.">som blir funnet.</em>
      </h1>

      <p class="hero__sub" data-nb="Nettsiden er ofte førsteinntrykket. Vi bygger den rask, synlig i søk og enkel å oppdatere selv, uten å ringe et byrå for hver endring." data-en="Your website is often the first impression. We build it fast, visible in search and easy to update yourself, without calling an agency for every change.">
        Nettsiden er ofte førsteinntrykket. Vi bygger den rask, synlig i søk og enkel å oppdatere selv, uten å ringe et byrå for hver endring.
      </p>

      <div class="hero__cta">
        <a href="mailto:hei@okane.no?subject=Nettsider" class="btn btn--primary btn--lg" data-nb="Start et prosjekt →" data-en="Start a project →">Start et prosjekt →</a>
        <a href="/#tjenester" class="btn btn--secondary btn--lg" data-nb="Alle tjenester" data-en="All services">Alle tjenester</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__eyebrow" data-nb="Det får du" data-en="What you get">Det får du</div>
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Bygget for å vare." data-en="Built to last.">Bygget for å vare.</h2>
          <p class="block__sub" data-nb="En nettside som jobber for deg, og som teamet ditt kan eie selv etter lansering." data-en="A website that works for you, and that your team can own after launch.">
            En nettside som jobber for deg, og som teamet ditt kan eie selv etter lansering.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__num">01</div>
          <div class="cap__body">
            <h4 data-nb="Design og innhold" data-en="Design and content">Design og innhold</h4>
            <p data-nb="Struktur, tekst og uttrykk som passer merkevaren din, ikke en mal fra et tema-bibliotek." data-en="Structure, copy and expression that fit your brand, not a template from a theme library.">Struktur, tekst og uttrykk som passer merkevaren din, ikke en mal fra et tema-bibliotek.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">02</div>
          <div class="cap__body">
            <h4 data-nb="SEO og ytelse" data-en="SEO and performance">SEO og ytelse</h4>
            <p data-nb="Bygget for å bli funnet i søk og score på Core Web Vitals. Fart er ikke en ettertanke." data-en="Built to be found in search and score on Core Web Vitals. Speed is not an afterthought.">Bygget for å bli funnet i søk og score på Core Web Vitals. Fart er ikke en ettertanke.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">03</div>
          <div class="cap__body">
            <h4 data-nb="Enkel publisering" data-en="Easy publishing">Enkel publisering</h4>
            <p data-nb="Du oppdaterer innholdet selv, med opplæring inkludert. Ingen byrå på timepris for å bytte et bilde." data-en="You update the content yourself, training included. No agency on hourly rates to swap an image.">Du oppdaterer innholdet selv, med opplæring inkludert. Ingen byrå på timepris for å bytte et bilde.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">04</div>
          <div class="cap__body">
            <h4 data-nb="Universell utforming" data-en="Accessibility">Universell utforming</h4>
            <p data-nb="Tilgjengelig for alle og i tråd med kravene, fra første versjon. Ikke en opprydding i etterkant." data-en="Accessible to everyone and compliant with the requirements, from version one. Not a cleanup afterwards.">Tilgjengelig for alle og i tråd med kravene, fra første versjon. Ikke en opprydding i etterkant.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2 data-nb="Klar for en nettside som jobber for deg?" data-en="Ready for a website that works for you?">Klar for en nettside som jobber for deg?</h2>
      <p data-nb="Send oss dagens nettside, så svarer vi med hva vi ville gjort annerledes. Helt uforpliktende." data-en="Send us your current website and we'll reply with what we would do differently. No strings attached.">
        Send oss dagens nettside, så svarer vi med hva vi ville gjort annerledes. Helt uforpliktende.
      </p>
      <div class="cta__row">
        <a href="mailto:hei@okane.no?subject=Nettsider" class="btn btn--primary btn--xl" data-nb="Skriv til oss →" data-en="Write to us →">Skriv til oss →</a>
        <a href="/" class="btn btn--ghost btn--xl" data-nb="Tilbake til forsiden" data-en="Back to the front page">Tilbake til forsiden</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
