---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Proof from '~/components/sections/Proof.astro';
import Process from '~/components/sections/Process.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CTA from '~/components/sections/CTA.astro';
import { mailto, prompts } from '~/lib/contact';
import bragePreview from '~/assets/produkter/brage/skjema.webp';

const contact = mailto('AI-agenter', prompts.project);

const faq = [
  {
    q: 'Hva skjer når agenten tar feil?',
    a: 'Vi bygger agentene slik vi har bygget <a href="/brage">Brage</a>. De oppgir kilden og hvor sikre de er, lar felt stå tomme når de ikke finner belegg, og et menneske godkjenner før noe sendes.',
  },
  {
    q: 'Hvem ser hva?',
    a: 'Agenten følger tilgangene dere allerede har, så hver person bare får svar fra dokumenter og data de selv har tilgang til.',
  },
  {
    q: 'Kan agenten kjøre på våre egne servere?',
    a: 'Ja. Agentene kan bruke en privat språkmodell, så dokumentene blir i deres egen infrastruktur. <a href="/brage/privat-ki">Slik kjører Brage på egne servere</a>, med søkeindeksen laget lokalt.',
  },
  {
    q: 'Hva koster en AI-agent?',
    a: 'Du får en fast pris for å bygge agenten etter et arbeidsmøte, før vi starter. Bruken av språkmodellen kommer i tillegg, og vi anslår den i forslaget.',
  },
];
---

<Layout
  title="AI-agenter for bedrifter, koblet til egne data · Okane"
  description="AI-agenter som gjør rutinearbeid i systemene dine, med tilgangsstyring og full logg over hva de gjorde og hvorfor."
  schema={[{"@type": "Service", "name": "AI-agenter", "serviceType": "Utvikling av AI-agenter", "url": "https://okane.no/ai-agenter", "description": "AI-agenter som gjør rutinearbeid i bedriftens systemer, med logg og tilgangsstyring.", "provider": {"@id": "https://okane.no/#org"}, "areaServed": {"@type": "Country", "name": "Norge"}}]}
>
  <Header ctaLabel="Be om pris og plan" ctaHref="#kontakt" ctaEvent="pris-og-plan" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <a href="/#tjenester" data-nb="Tjenester" data-en="Services">Tjenester</a>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span>Agenter som tar rutinearbeidet</span><br>
        <em>og viser hva de gjorde.</em>
      </h1>

      <p class="hero__sub">
        Vi bygger AI-agenter som svarer på spørsmål, fyller ut skjema og holder systemene dine oppdatert. Hver handling logges med kilde, og et menneske godkjenner der det trengs.
      </p>

      <div class="hero__cta">
        <a href={contact} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="pris-og-plan">Be om pris og plan</a>
        <a href="/brage" class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="se-brage">Se Brage</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title">Automatisering du kan stole på.</h2>
          <p class="block__sub">
            Agentene gjør arbeid i systemene dine og logger hva de gjorde og hvorfor.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4>Skjema og rapporter</h4>
            <p>Agenter som fyller ut skjema og rapporter fra dokumentene dine, med kilde på hvert felt.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Kundeservice</h4>
            <p>Svar på vanlige henvendelser i din tone, med full logg og eskalering til mennesker når det trengs.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Automatiserte arbeidsflyter</h4>
            <p>Flertrinns prosesser på tvers av systemene dine, overvåket og sporbare fra start til slutt.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Trygghet og kontroll</h4>
            <p>Agenten ser bare data den har fått tilgang til, og du ser hva den gjorde og hvorfor.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Proof
    title="Brage fyller ut offentlige skjema fra dokumentene deres."
    text="Brage er vår egen agent. Den fyller ut skjema i Altinn med kilde på hvert felt og svarer på spørsmål om dokumentene. En saksbehandler godkjenner før noe sendes."
    href="/brage"
    label="Se Brage"
    event="se-brage"
    image={bragePreview}
    alt="Et utkast til aksjonærregisteroppgaven i Brage, med kilde til hvert felt"
  />

  <Process />

  <FAQ title="Spørsmål om AI-agenter." sub="Det vi oftest får spørsmål om før en agent. Lurer du på noe annet, er det bare å spørre." items={faq} />

  <CTA
    title="Hva gjør folkene dine på repeat?"
    text="Beskriv rutinearbeidet, så svarer vi med hva en agent kan ta over, og hva som fortsatt bør gjøres av mennesker."
    primary={{ label: 'Be om pris og plan', href: contact, event: 'pris-og-plan' }}
    secondary={{ label: 'Se Brage', href: '/brage', event: 'se-brage' }}
  />

  <Footer />
</Layout>
