---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import CTA from '~/components/sections/CTA.astro';
import Zoom from '~/components/ui/Zoom.astro';
import { mailto, prompts } from '~/lib/contact';
import skjema from '~/assets/produkter/brage/skjema.webp';
import sporsmal from '~/assets/produkter/brage/sporsmal.webp';
import skjemaer from '~/assets/produkter/brage/skjemaer.webp';
import arbeidsflyt from '~/assets/produkter/brage/arbeidsflyt.webp';

const start = mailto('Kom i gang med Brage', prompts.brageStart);
const demo = mailto('Demo Brage', prompts.brageDemo);
---

<Layout
  title="Brage – Altinn-skjema og KI på egne dokumenter"
  description="Brage fyller ut skjema i Altinn fra virksomhetens egne dokumenter og svarer på spørsmål om dem, med kilde. Språkmodellen kan kjøre på egne servere, og ingenting sendes uten godkjenning."
  image="/og/brage.png"
  imageAlt="Brage: et utkast til aksjonærregisteroppgaven med kilde på hvert felt"
  schema={[{"@type": "SoftwareApplication", "@id": "https://okane.no/brage#app", "name": "Brage", "applicationCategory": "BusinessApplication", "operatingSystem": "Web", "inLanguage": "nb", "url": "https://okane.no/brage", "description": "Fyller ut offentlige skjema i Altinn fra virksomhetens egne dokumenter, med kilde på hvert felt. En saksbehandler godkjenner før innsending.", "featureList": ["Fyller ut skjema i Altinn fra egne dokumenter, med kilde på hvert felt", "Sender aksjonærregisteroppgaven (RF-1086) til Skatteetaten med systembruker i Altinn", "Spørsmål og svar på egne dokumenter, med kilde til hver påstand", "Leser dokumenter fra SharePoint gjennom Microsoft Graph og fra filområder", "Hver person får bare svar fra dokumenter Entra ID-gruppene eller en direkte deling gir tilgang til", "Kan kjøre på en privat språkmodell i Ollama, i egen infrastruktur", "Hybrid søk med vektorer (pgvector) og fulltekst"], "publisher": {"@id": "https://okane.no/#org"}}]}
>
  <Header ctaLabel="Be om en demo" ctaHref="#kontakt" ctaEvent="demo-brage" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <span data-nb="Produkt fra Okane" data-en="A product by Okane">Produkt fra Okane</span>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span data-nb="Skjemaene fylles ut." data-en="The forms fill themselves.">Skjemaene fylles ut.</span><br>
        <em data-nb="Du godkjenner." data-en="You approve.">Du godkjenner.</em>
      </h1>

      <p class="hero__sub" data-nb="Opplysningene ligger allerede i dokumentene deres. Brage fyller ut skjemaet i Altinn fra dem og viser hvor hvert tall kommer fra, og en saksbehandler godkjenner før noe sendes. Ansatte kan også stille spørsmål til dokumentene og få svar med kilde. Språkmodellen kan kjøre på deres egne servere." data-en="The information is already in your documents. Brage fills in the Altinn form from them and shows where every figure comes from, and a case worker approves before anything is sent. Staff can also ask the documents questions and get answers with sources. The language model can run on your own servers.">
        Opplysningene ligger allerede i dokumentene deres. Brage fyller ut skjemaet i Altinn fra dem og viser hvor hvert tall kommer fra, og en saksbehandler godkjenner før noe sendes. Ansatte kan også stille spørsmål til dokumentene og få svar med kilde. Språkmodellen kan kjøre på deres egne servere.
      </p>

      <div class="hero__cta">
        <a href={demo} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="demo-brage">Be om en demo</a>
        <a href={start} class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="start-brage">Prøv på egne dokumenter</a>
      </div>

      <div class="hero__meta">
        <span><b data-nb="34 skjema" data-en="34 forms">34 skjema</b> <span data-nb="fra 17 etater" data-en="from 17 agencies">fra 17 etater</span></span>
        <span><b data-nb="Spør dokumentene" data-en="Ask the documents">Spør dokumentene</b> <span data-nb="og få svar med kilde" data-en="and get answers with sources">og få svar med kilde</span></span>
        <span><b data-nb="Privat språkmodell" data-en="A private language model">Privat språkmodell</b> <span data-nb="på egne servere" data-en="on your own servers">på egne servere</span></span>
      </div>

      <div class="hero__device">
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Skjema" data-en="Form">Skjema</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image
              src={skjema}
              alt="Et utkast til aksjonærregisteroppgaven i Brage: feltene er fylt ut med kilde til hvert, kontrollene er bestått, og agenten forklarer hva den har gjort i et panel til høyre"
              widths={[760, 1200, 2000, 2880]}
              sizes="(max-width: 880px) 100vw, 1100px"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Fra dokumenter&lt;br&gt;til innsendt skjema." data-en="From documents&lt;br&gt;to a filed form.">Fra dokumenter<br>til innsendt skjema.</h2>
          <p class="block__sub" data-nb="Brage gjør grovarbeidet og lar fagpersonen ta beslutningene. Alt den fyller ut kan spores tilbake til et dokument." data-en="Brage does the groundwork and leaves the decisions to the professional. Everything it fills in can be traced back to a document.">
            Brage gjør grovarbeidet og lar fagpersonen ta beslutningene. Alt den fyller ut kan spores tilbake til et dokument.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Utkast med kilder" data-en="Drafts with sources">Utkast med kilder</h4>
            <p data-nb="Agenten søker i dokumentene, fyller ut feltene og oppgir kilden og hvor sikker den er for hvert av dem. Det den ikke finner belegg for, lar den stå tomt." data-en="The agent searches the documents, fills in the fields and gives the source and its confidence for each one. Where it finds no evidence, it leaves the field empty.">Agenten søker i dokumentene, fyller ut feltene og oppgir kilden og hvor sikker den er for hvert av dem. Det den ikke finner belegg for, lar den stå tomt.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Kontroller per skjema" data-en="Checks for each form">Kontroller per skjema</h4>
            <p data-nb="Aksjer som må gå opp, mva som må stemme med grunnlaget, frister som må holdes. Feilene vises før noen godkjenner." data-en="Shares that must reconcile, VAT that must match its base, deadlines that must be met. Errors show before anyone approves.">Aksjer som må gå opp, mva som må stemme med grunnlaget, frister som må holdes. Feilene vises før noen godkjenner.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Du har siste ord" data-en="You have the final say">Du har siste ord</h4>
            <p data-nb="Rett et felt, eller be agenten sjekke noe på nytt. En person godkjenner før noe sendes, og alle endringer står i historikken." data-en="Correct a field, or ask the agent to check something again. A person approves before anything is sent, and every change is in the history.">Rett et felt, eller be agenten sjekke noe på nytt. En person godkjenner før noe sendes, og alle endringer står i historikken.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Spør dokumentene" data-en="Ask the documents">Spør dokumentene</h4>
            <p data-nb="Still spørsmål på norsk og få svar med henvisning til dokumentet. Hver person ser bare dokumentene de har tilgang til." data-en="Ask in plain language and get answers that point to the document. Each person only sees the documents they have access to.">Still spørsmål på norsk og få svar med henvisning til dokumentet. Hver person ser bare dokumentene de har tilgang til.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Faste innsendinger" data-en="Recurring filings">Faste innsendinger</h4>
            <p data-nb="Sett opp et skjema til å fylles ut hver uke, måned eller år for hvert selskap, med de dokumentene det trenger lagt ved." data-en="Set a form to be filled in every week, month or year for each company, with the documents it needs attached.">Sett opp et skjema til å fylles ut hver uke, måned eller år for hvert selskap, med de dokumentene det trenger lagt ved.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Der dokumentene ligger" data-en="Where your documents are">Der dokumentene ligger</h4>
            <p data-nb="Leser fra SharePoint og filområder, slår opp selskaper i Enhetsregisteret og sender inn med systembruker i Altinn. Kan kjøres med lokale språkmodeller." data-en="Reads from SharePoint and file shares, looks companies up in Enhetsregisteret and files with an Altinn system user. Can run on local language models.">Leser fra SharePoint og filområder, slår opp selskaper i Enhetsregisteret og sender inn med systembruker i Altinn. Kan kjøres på <a href="/brage/privat-ki">en privat språkmodell</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="KI på egne dokumenter.&lt;br&gt;Dataene blir hos dere." data-en="AI on your own documents.&lt;br&gt;The data stays with you.">KI på egne dokumenter.<br>Dataene blir hos dere.</h2>
          <p class="block__sub" data-nb="Svaret ligger i en protokoll eller avtale et sted i SharePoint, men du må vite hvor du skal lete. Spør Brage på norsk, så får du svaret med lenke til dokumentet det bygger på. Hvem kjøpte aksjer i juni, og til hvilken pris? Hva sier leieavtalen om oppsigelse?" data-en="The answer is in a set of minutes or an agreement somewhere in SharePoint, but you have to know where to look. Ask Brage in Norwegian and get the answer with a link to the document behind it. Who bought shares in June, and at what price? What does the lease say about termination?">
            Svaret ligger i en protokoll eller avtale et sted i SharePoint, men du må vite hvor du skal lete. Spør Brage på norsk, så får du svaret med lenke til dokumentet det bygger på. Hvem kjøpte aksjer i juni, og til hvilken pris? Hva sier leieavtalen om oppsigelse?
          </p>
        </div>
      </header>

      <div class="preview reveal">
        <div class="preview__bar">
          <div class="lights"><span></span><span></span><span></span></div>
          <div class="preview__url">Chat</div>
        </div>
        <div class="preview__body preview__body--shot">
          <Image
            src={sporsmal}
            alt="Et spørsmål i Brage om hvem som kjøpte aksjer i Acme AS i juni 2026, med svar og henvisning til aksjeoverdragelsen"
            widths={[760, 1200, 2000, 2880]}
            sizes="(max-width: 880px) 100vw, 1100px"
          />
        </div>
      </div>

      <div class="caps brain-caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4>Svar du kan sjekke</h4>
            <p>Brage søker både på ord og på mening, og svarer bare ut fra utdragene den finner. Hver påstand lenker til dokumentet. Står svaret ikke i dokumentene, sier Brage det.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Samme tilgang som i dag</h4>
            <p>Hver person får bare svar fra dokumenter Entra ID-gruppene eller en direkte deling gir dem tilgang til. Styrepapirer blir hos styret.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Privat språkmodell</h4>
            <p>Språkmodellen kan kjøre på deres egne servere eller i deres egen sky. Da blir dokumentene, spørsmålene og søkeindeksen i deres infrastruktur.</p>
          </div>
        </div>
      </div>

      <div class="privat-note reveal">
        <p>Se hvor dataene ligger, hvilke modeller Brage kan bruke, og hva IT pleier å spørre om.</p>
        <a href="/brage/privat-ki" class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="sporsmal" data-umami-event-label="se-privat-ki">Les om privat KI i Brage</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Fra Skatteetaten&lt;br&gt;til Mattilsynet." data-en="From the Tax Administration&lt;br&gt;to the Food Safety Authority.">Fra Skatteetaten<br>til Mattilsynet.</h2>
          <p class="block__sub" data-nb="Regnskap, lønn, akvakultur, byggesak, helse og finans. Velg et skjema, eller la det fylles ut på fast tidspunkt for selskapene dere fører." data-en="Accounting, payroll, aquaculture, building permits, health and finance. Pick a form, or have it filled in on a schedule for the companies you handle.">
            Regnskap, lønn, akvakultur, byggesak, helse og finans. Velg et skjema, eller la det fylles ut på fast tidspunkt for selskapene dere fører.
          </p>
        </div>
      </header>

      <div class="shot-pair reveal">
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Skjemaer" data-en="Forms">Skjemaer</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image src={skjemaer} alt="Skjemaoversikten i Brage, gruppert etter etat" widths={[760, 1200, 2000]} sizes="(max-width: 880px) 100vw, 560px" />
          </div>
        </div>
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Ny arbeidsflyt" data-en="New workflow">Ny arbeidsflyt</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image src={arbeidsflyt} alt="Oppsett av en arbeidsflyt i Brage: skjema, selskaper, tidsplan og dokumenttyper som legges ved" widths={[760, 1200, 2000]} sizes="(max-width: 880px) 100vw, 560px" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title">Slik kommer dere i gang.</h2>
          <p class="block__sub">
            For virksomheter som sender de samme skjemaene igjen og igjen, for ett selskap eller for mange.
          </p>
        </div>
      </header>

      <div class="caps caps--steps reveal">
        <div class="cap">
          <div class="cap__num">1</div>
          <div class="cap__body">
            <h4>Velg skjemaene</h4>
            <p>Vi setter opp Brage på skjemaene dere sender inn i dag, for ett selskap eller for alle dere fører.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">2</div>
          <div class="cap__body">
            <h4>Koble til dokumentene</h4>
            <p>Brage leser fra SharePoint eller et filområde. Hver person ser bare dokumentene de har tilgang til.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">3</div>
          <div class="cap__body">
            <h4>Gi Brage en systembruker</h4>
            <p>Noen som forvalter selskapets rettigheter i Altinn, godkjenner Brage én gang per selskap.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">4</div>
          <div class="cap__body">
            <h4>Godkjenn og send</h4>
            <p>Dere går gjennom hvert utkast og godkjenner alt før noe sendes.</p>
          </div>
        </div>
      </div>

      <p class="start-terms">Det første skjemaet setter vi opp på deres egne dokumenter. Dere betaler først når dere vil fortsette.</p>
      <div class="hero__cta">
        <a href={start} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="start" data-umami-event-label="start-brage">Prøv på egne dokumenter</a>
      </div>
    </div>
  </section>

  <CTA
    title="Se Brage fylle ut et av skjemaene deres."
    text="Fortell hvilke skjema dere sender inn i dag, så viser vi Brage på et av dem."
    primary={{ label: 'Be om en demo', href: demo, event: 'demo-brage' }}
    secondary={{ label: 'Prøv på egne dokumenter', href: start, event: 'start-brage' }}
  />

  <Footer />
  <Zoom />
</Layout>
