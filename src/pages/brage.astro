---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import MailNote from '~/components/sections/MailNote.astro';
import CTA from '~/components/sections/CTA.astro';
import { mailto, prompts } from '~/lib/contact';
import { brageForms } from '~/data/brage-skjema';
import skjema from '~/assets/produkter/brage/skjema.webp';
import sporsmal from '~/assets/produkter/brage/sporsmal.webp';
import skjemaer from '~/assets/produkter/brage/skjemaer.webp';
import arbeidsflyt from '~/assets/produkter/brage/arbeidsflyt.webp';

const pilot = mailto('Pilot Brage', prompts.bragePilot);
const demo = mailto('Demo Brage', prompts.brageDemo);
---

<Layout
  title="Brage – Altinn-skjema og aksjonærregisteroppgaven"
  description="Brage fyller ut skjema i Altinn, som aksjonærregisteroppgaven, fra virksomhetens egne dokumenter. Kilde på hvert felt, og ingenting sendes uten godkjenning."
  image="/og/brage.png"
  imageAlt="Brage: et utkast til aksjonærregisteroppgaven med kilde på hvert felt"
  schema={[{"@type": "SoftwareApplication", "name": "Brage", "applicationCategory": "BusinessApplication", "operatingSystem": "Web", "inLanguage": "nb", "url": "https://okane.no/brage", "description": "Fyller ut offentlige skjema i Altinn fra virksomhetens egne dokumenter, med kilde på hvert felt. En saksbehandler godkjenner før innsending.", "publisher": {"@id": "https://okane.no/#org"}}]}
>
  <Header ctaLabel="Søk om pilotplass" ctaHref="#kontakt" ctaEvent="pilot-brage" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <span data-nb="Produkt fra Okane, i pilot" data-en="A product by Okane, in pilot">Produkt fra Okane, i pilot</span>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span data-nb="Skjemaene fylles ut." data-en="The forms fill themselves.">Skjemaene fylles ut.</span><br>
        <em data-nb="Du godkjenner." data-en="You approve.">Du godkjenner.</em>
      </h1>

      <p class="hero__sub" data-nb="Aksjonærregisteroppgaven, a-meldingen, lusetellingen: opplysningene ligger allerede i dokumentene deres. Brage leser dem, fyller ut skjemaet i Altinn og viser hvor hvert tall kommer fra. En saksbehandler går gjennom, godkjenner og sender." data-en="The shareholder register statement, the a-melding, the sea lice count: the information is already in your documents. Brage reads them, fills in the Altinn form and shows where every figure comes from. A case worker reviews, approves and submits.">
        Aksjonærregisteroppgaven, a-meldingen, lusetellingen: opplysningene ligger allerede i dokumentene deres. Brage leser dem, fyller ut skjemaet i Altinn og viser hvor hvert tall kommer fra. En saksbehandler går gjennom, godkjenner og sender.
      </p>

      <div class="hero__cta">
        <a href={pilot} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="pilot-brage">Søk om pilotplass</a>
        <a href={demo} class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="demo-brage">Be om en demo</a>
      </div>
      <MailNote location="hero" />

      <div class="hero__meta">
        <span><b data-nb="34 skjema" data-en="34 forms">34 skjema</b> <span data-nb="fra 17 etater" data-en="from 17 agencies">fra 17 etater</span></span>
        <span><b data-nb="Kilde" data-en="A source">Kilde</b> <span data-nb="på hvert felt" data-en="for every field">på hvert felt</span></span>
        <span><b data-nb="Ingenting sendes" data-en="Nothing is sent">Ingenting sendes</b> <span data-nb="uten godkjenning" data-en="without approval">uten godkjenning</span></span>
      </div>

      <div class="hero__device">
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Skjema" data-en="Form">Skjema</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image
              src={skjema}
              alt="Et utkast til aksjonærregisteroppgaven i Brage: feltene er fylt ut med kilde til hvert, kontrollene er bestått, og agenten forklarer hva den har gjort i et panel til høyre"
              widths={[760, 1200, 2000, 2880]}
              sizes="(max-width: 880px) 100vw, 1100px"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Fra dokumenter&lt;br&gt;til innsendt skjema." data-en="From documents&lt;br&gt;to a filed form.">Fra dokumenter<br>til innsendt skjema.</h2>
          <p class="block__sub" data-nb="Brage gjør grovarbeidet og lar fagpersonen ta beslutningene. Alt den fyller ut kan spores tilbake til et dokument." data-en="Brage does the groundwork and leaves the decisions to the professional. Everything it fills in can be traced back to a document.">
            Brage gjør grovarbeidet og lar fagpersonen ta beslutningene. Alt den fyller ut kan spores tilbake til et dokument.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Utkast med kilder" data-en="Drafts with sources">Utkast med kilder</h4>
            <p data-nb="Agenten søker i dokumentene, fyller ut feltene og oppgir kilden og hvor sikker den er for hvert av dem. Det den ikke finner belegg for, lar den stå tomt." data-en="The agent searches the documents, fills in the fields and gives the source and its confidence for each one. Where it finds no evidence, it leaves the field empty.">Agenten søker i dokumentene, fyller ut feltene og oppgir kilden og hvor sikker den er for hvert av dem. Det den ikke finner belegg for, lar den stå tomt.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Kontroller per skjema" data-en="Checks for each form">Kontroller per skjema</h4>
            <p data-nb="Aksjer som må gå opp, mva som må stemme med grunnlaget, frister som må holdes. Feilene vises før noen godkjenner." data-en="Shares that must reconcile, VAT that must match its base, deadlines that must be met. Errors show before anyone approves.">Aksjer som må gå opp, mva som må stemme med grunnlaget, frister som må holdes. Feilene vises før noen godkjenner.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Du har siste ord" data-en="You have the final say">Du har siste ord</h4>
            <p data-nb="Rett et felt, eller be agenten sjekke noe på nytt. En person godkjenner før noe sendes, og alle endringer står i historikken." data-en="Correct a field, or ask the agent to check something again. A person approves before anything is sent, and every change is in the history.">Rett et felt, eller be agenten sjekke noe på nytt. En person godkjenner før noe sendes, og alle endringer står i historikken.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Spør dokumentene" data-en="Ask the documents">Spør dokumentene</h4>
            <p data-nb="Still spørsmål på norsk og få svar med henvisning til dokumentet. Hver person ser bare dokumentene de har tilgang til." data-en="Ask in plain language and get answers that point to the document. Each person only sees the documents they have access to.">Still spørsmål på norsk og få svar med henvisning til dokumentet. Hver person ser bare dokumentene de har tilgang til.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Faste innsendinger" data-en="Recurring filings">Faste innsendinger</h4>
            <p data-nb="Sett opp et skjema til å fylles ut hver uke, måned eller år for hvert selskap, med de dokumentene det trenger lagt ved." data-en="Set a form to be filled in every week, month or year for each company, with the documents it needs attached.">Sett opp et skjema til å fylles ut hver uke, måned eller år for hvert selskap, med de dokumentene det trenger lagt ved.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Der dokumentene ligger" data-en="Where your documents are">Der dokumentene ligger</h4>
            <p data-nb="Leser fra SharePoint og filområder, slår opp selskaper i Enhetsregisteret og sender inn med systembruker i Altinn. Kan kjøres med lokale språkmodeller." data-en="Reads from SharePoint and file shares, looks companies up in Enhetsregisteret and files with an Altinn system user. Can run on local language models.">Leser fra SharePoint og filområder, slår opp selskaper i Enhetsregisteret og sender inn med systembruker i Altinn. Kan kjøres med lokale språkmodeller.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="qa qa--solo reveal">
        <h2>Aksjonærregisteroppgaven <span class="nowrap">(RF-1086)</span> fra protokoller og avtaler</h2>
        <div class="qa__body">
          <p>Brage fyller ut aksjonærregisteroppgaven fra generalforsamlingsprotokoller, aksjeoverdragelser og fjorårets oppgave. Den avstemmer beholdningen for hver aksjonær, lager én RF-1086-U per aksjonær og sender oppgaven til Skatteetaten med selskapets systembruker i Altinn når dere har godkjent. Fristen er 31. januar.</p>
          <ul>
            <li>Inngående beholdning hentes fra fjorårets oppgave, sendt gjennom Brage eller hentet fra Skatteetaten.</li>
            <li>Kapitalendringer, overdragelser og utbytte hentes fra dokumentene, med kilde på hvert tall.</li>
            <li>Kontrollene stopper oppgaven til aksjene går opp, for selskapet og for hver aksjonær.</li>
            <li>Skatteetatens kvittering vises på kjøringen. Avviser Skatteetaten oppgaven, står begrunnelsen der, så dere kan rette og sende på nytt.</li>
          </ul>
          <p><a href="/altinn-integrasjon">Slik sender vi inn skjema med systembruker og Maskinporten</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Svar du kan&lt;br&gt;sjekke selv." data-en="Answers you can&lt;br&gt;check yourself.">Svar du kan<br>sjekke selv.</h2>
          <p class="block__sub" data-nb="Hvem kjøpte aksjer i juni, og til hvilken pris? Brage finner det i protokollene og avtalene, og lenker til dokumentet svaret bygger på." data-en="Who bought shares in June, and at what price? Brage finds it in the minutes and agreements, and links to the document the answer is based on.">
            Hvem kjøpte aksjer i juni, og til hvilken pris? Brage finner det i protokollene og avtalene, og lenker til dokumentet svaret bygger på.
          </p>
        </div>
      </header>

      <div class="preview reveal">
        <div class="preview__bar">
          <div class="lights"><span></span><span></span><span></span></div>
          <div class="preview__url">Chat</div>
        </div>
        <div class="preview__body preview__body--shot">
          <Image
            src={sporsmal}
            alt="Et spørsmål i Brage om hvem som kjøpte aksjer i Acme AS i juni 2026, med svar og henvisning til aksjeoverdragelsen"
            widths={[760, 1200, 2000, 2880]}
            sizes="(max-width: 880px) 100vw, 1100px"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Fra Skatteetaten&lt;br&gt;til Mattilsynet." data-en="From the Tax Administration&lt;br&gt;to the Food Safety Authority.">Fra Skatteetaten<br>til Mattilsynet.</h2>
          <p class="block__sub" data-nb="Regnskap, lønn, akvakultur, byggesak, helse og finans. Velg et skjema, eller la det fylles ut på fast tidspunkt for selskapene dere fører." data-en="Accounting, payroll, aquaculture, building permits, health and finance. Pick a form, or have it filled in on a schedule for the companies you handle.">
            Regnskap, lønn, akvakultur, byggesak, helse og finans. Velg et skjema, eller la det fylles ut på fast tidspunkt for selskapene dere fører.
          </p>
        </div>
      </header>

      <div class="shot-pair reveal">
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Skjemaer" data-en="Forms">Skjemaer</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image src={skjemaer} alt="Skjemaoversikten i Brage, gruppert etter etat" widths={[760, 1200, 2000]} sizes="(max-width: 880px) 100vw, 560px" />
          </div>
        </div>
        <div class="preview">
          <div class="preview__bar">
            <div class="lights"><span></span><span></span><span></span></div>
            <div class="preview__url" data-nb="Ny arbeidsflyt" data-en="New workflow">Ny arbeidsflyt</div>
          </div>
          <div class="preview__body preview__body--shot">
            <Image src={arbeidsflyt} alt="Oppsett av en arbeidsflyt i Brage: skjema, selskaper, tidsplan og dokumenttyper som legges ved" widths={[760, 1200, 2000]} sizes="(max-width: 880px) 100vw, 560px" />
          </div>
        </div>
      </div>

      <div class="table-wrap forms-wrap reveal">
        <table class="table forms-table">
          <caption class="forms-caption">Skjemaene Brage fyller ut, etter etat</caption>
          <thead>
            <tr>
              <th scope="col">Skjema</th>
              <th scope="col">Etat</th>
              <th scope="col">Skjemanummer</th>
              <th scope="col">Frekvens</th>
            </tr>
          </thead>
          <tbody>
            {brageForms.map((form) => (
              <tr>
                <td>{form.title}</td>
                <td data-label="Etat">{form.authority}</td>
                <td data-label="Skjemanummer"><span class="mono">{form.formId ?? '–'}</span></td>
                <td data-label="Frekvens">{form.period}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title">Slik fungerer piloten.</h2>
          <p class="block__sub">
            For virksomheter som sender de samme skjemaene igjen og igjen, for ett selskap eller for mange.
          </p>
        </div>
      </header>

      <div class="caps caps--steps reveal">
        <div class="cap">
          <div class="cap__num">1</div>
          <div class="cap__body">
            <h4>Velg skjemaene</h4>
            <p>Vi setter opp Brage på 1–3 av skjemaene dere sender inn i dag.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">2</div>
          <div class="cap__body">
            <h4>Koble til dokumentene</h4>
            <p>Brage leser fra SharePoint eller et filområde. Hver person ser bare dokumentene de har tilgang til.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">3</div>
          <div class="cap__body">
            <h4>Gi Brage en systembruker</h4>
            <p>Noen som forvalter selskapets rettigheter i Altinn, godkjenner Brage én gang per selskap.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">4</div>
          <div class="cap__body">
            <h4>Godkjenn og send</h4>
            <p>Dere går gjennom hvert utkast og godkjenner alt før noe sendes.</p>
          </div>
        </div>
      </div>

      <p class="pilot-terms">Pris og vilkår avtaler vi i et kort møte.</p>
      <div class="hero__cta">
        <a href={pilot} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="pilot" data-umami-event-label="pilot-brage">Søk om pilotplass</a>
      </div>
      <MailNote location="pilot" />
    </div>
  </section>

  <CTA
    title="Se Brage fylle ut et av skjemaene deres."
    text="Fortell hvilke skjema dere sender inn i dag, så setter vi opp Brage på dem i en pilot. Vil dere se Brage først, viser vi den gjerne."
    primary={{ label: 'Søk om pilotplass', href: pilot, event: 'pilot-brage' }}
    secondary={{ label: 'Be om en demo', href: demo, event: 'demo-brage' }}
  />

  <Footer />
</Layout>
