---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
---

<Layout
  title="Okane Commerce · Netthandel, uten støy."
  description="Nettbutikk, kasse og lager i ett system, bygget for norske merkevarer. Vipps, Klarna, frakt og regnskap ferdig integrert."
>
  <Header />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <span class="pulse"></span>
        <span data-nb="Produkt fra Okane · I produksjon" data-en="A product by Okane · In production">Produkt fra Okane · I produksjon</span>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span data-nb="Netthandel," data-en="Commerce,">Netthandel,</span><br>
        <em data-nb="uten støy." data-en="without the noise.">uten støy.</em>
      </h1>

      <p class="hero__sub" data-nb="Nettbutikk, kasse og lager i ett system, bygget for norske merkevarer. Vipps, Klarna, frakt og regnskap er ferdig integrert fra dag én." data-en="Storefront, point of sale and inventory in one system, built for Norwegian brands. Vipps, Klarna, shipping and accounting are integrated from day one.">
        Nettbutikk, kasse og lager i ett system, bygget for norske merkevarer. Vipps, Klarna, frakt og regnskap er ferdig integrert fra dag én.
      </p>

      <div class="hero__cta">
        <a href="mailto:hei@okane.no?subject=Demo%20Okane%20Commerce" class="btn btn--primary btn--lg" data-nb="Be om en demo →" data-en="Request a demo →">Be om en demo →</a>
        <a href="/#produkter" class="btn btn--secondary btn--lg" data-nb="Alle produkter" data-en="All products">Alle produkter</a>
      </div>

      <div class="hero__meta">
        <span><b data-nb="Vipps og Klarna" data-en="Vipps and Klarna">Vipps og Klarna</b> <span data-nb="innebygd" data-en="built in">innebygd</span></span>
        <span><b data-nb="Migrering" data-en="Migration">Migrering</b> <span data-nb="inkludert" data-en="included">inkludert</span></span>
        <span><b data-nb="Support" data-en="Support">Support</b> <span data-nb="på norsk" data-en="in Norwegian">på norsk</span></span>
      </div>

      <div class="hero__device">
        <div class="hero__device-inner">
          <div class="device__side">
            <div class="device__brand">
              <div class="topnav__logo">N</div>
              <b>Northwind</b>
            </div>
            <nav class="device__nav">
              <a href="#" class="is-active" data-nb="Oversikt" data-en="Overview">Oversikt</a>
              <a href="#" data-nb="Ordrer" data-en="Orders">Ordrer</a>
              <a href="#" data-nb="Produkter" data-en="Products">Produkter</a>
              <a href="#" data-nb="Kunder" data-en="Customers">Kunder</a>
              <a href="#" data-nb="Lager" data-en="Inventory">Lager</a>
              <a href="#" data-nb="Kasse" data-en="POS">Kasse</a>
              <a href="#" data-nb="Analyse" data-en="Analytics">Analyse</a>
            </nav>
          </div>

          <div class="device__main">
            <div class="device__head">
              <div>
                <h4 data-nb="I dag" data-en="Today">I dag</h4>
                <div class="muted" data-nb="Onsdag, 29. april 2026" data-en="Wednesday, 29 April 2026">Onsdag, 29. april 2026</div>
              </div>
              <div class="row gap-2">
                <button class="btn btn--secondary btn--sm" data-nb="Eksporter" data-en="Export">Eksporter</button>
                <button class="btn btn--primary btn--sm" data-nb="+ Nytt produkt" data-en="+ New product">+ Nytt produkt</button>
              </div>
            </div>

            <div class="device__stats">
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Omsetning" data-en="Revenue">Omsetning</div>
                <div class="device__stat-value tabular">kr 124 080</div>
                <div class="device__stat-delta up">▲ 8,2% <span data-nb="mot i går" data-en="vs yesterday">mot i går</span></div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Ordrer" data-en="Orders">Ordrer</div>
                <div class="device__stat-value tabular">84</div>
                <div class="device__stat-delta up">▲ 4 <span data-nb="mot i går" data-en="vs yesterday">mot i går</span></div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label">AOV</div>
                <div class="device__stat-value tabular">kr 1 477</div>
                <div class="device__stat-delta down">▼ 1,1%</div>
              </div>
              <div class="device__stat">
                <div class="device__stat-label" data-nb="Konvertering" data-en="Conversion">Konvertering</div>
                <div class="device__stat-value tabular">3,4%</div>
                <div class="device__stat-delta up">▲ 0,2 pp</div>
              </div>
            </div>

            <div class="device__chart">
              <svg viewBox="0 0 600 64" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="chart-grad" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent-bg)" stop-opacity="0.18"/>
                    <stop offset="100%" stop-color="var(--accent-bg)" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,48 L40,42 L80,46 L120,38 L160,40 L200,30 L240,34 L280,22 L320,28 L360,18 L400,24 L440,14 L480,20 L520,10 L560,16 L600,8" fill="none" stroke="var(--accent-bg)" stroke-width="1.6"/>
                <path d="M0,48 L40,42 L80,46 L120,38 L160,40 L200,30 L240,34 L280,22 L320,28 L360,18 L400,24 L440,14 L480,20 L520,10 L560,16 L600,8 L600,64 L0,64 Z" fill="url(#chart-grad)"/>
              </svg>
            </div>

            <div class="table-wrap">
              <table class="table tabular">
                <thead>
                  <tr>
                    <th data-nb="Ordre" data-en="Order">Ordre</th>
                    <th data-nb="Kunde" data-en="Customer">Kunde</th>
                    <th data-nb="Status" data-en="Status">Status</th>
                    <th class="num" data-nb="Sum" data-en="Total">Sum</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span class="mono">#ORD-7G2A</span></td>
                    <td>Elin Larsen</td>
                    <td><span class="badge badge--success"><span class="dot"></span><span data-nb="Betalt" data-en="Paid">Betalt</span></span></td>
                    <td class="num">kr 2 480</td>
                  </tr>
                  <tr>
                    <td><span class="mono">#ORD-7G29</span></td>
                    <td>Jonas Müller</td>
                    <td><span class="badge badge--warning"><span class="dot"></span><span data-nb="Venter" data-en="Pending">Venter</span></span></td>
                    <td class="num">kr 14 205</td>
                  </tr>
                  <tr>
                    <td><span class="mono">#ORD-7G27</span></td>
                    <td>Saoirse Hayes</td>
                    <td><span class="badge badge--info"><span class="dot"></span><span data-nb="Sendt" data-en="Shipped">Sendt</span></span></td>
                    <td class="num">kr 740</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__eyebrow" data-nb="Funksjoner" data-en="Capabilities">Funksjoner</div>
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Alt inkludert.&lt;br&gt;Ingen plugin-jakt." data-en="All included.&lt;br&gt;No plugin hunting.">Alt inkludert.<br>Ingen plugin-jakt.</h2>
          <p class="block__sub" data-nb="Det du trenger for å drive netthandel er med fra start. Trenger du noe spesielt, bygger vi det." data-en="What you need to run commerce is there from the start. Need something specific? We build it.">
            Det du trenger for å drive netthandel er med fra start. Trenger du noe spesielt, bygger vi det.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__num">01</div>
          <div class="cap__body">
            <h4 data-nb="Vipps Hurtigkasse" data-en="Vipps Fast Checkout">Vipps Hurtigkasse</h4>
            <p data-nb="Ferdig integrert, uten ekstra avtale. Norske kunder konverterer best med Vipps." data-en="Fully integrated, no extra contract. Norwegian customers convert best with Vipps.">Ferdig integrert, uten ekstra avtale. Norske kunder konverterer best med Vipps.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">02</div>
          <div class="cap__body">
            <h4 data-nb="Klarna i tre klikk" data-en="Klarna in three clicks">Klarna i tre klikk</h4>
            <p data-nb="Faktura og delbetaling slått på fra adminpanelet. Fungerer på nett og i butikk." data-en="Invoice and part payment toggled from admin. Works online and in-store.">Faktura og delbetaling slått på fra adminpanelet. Fungerer på nett og i butikk.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">03</div>
          <div class="cap__body">
            <h4 data-nb="Posten og Bring" data-en="Posten and Bring">Posten og Bring</h4>
            <p data-nb="Etiketter genereres automatisk, sporing sendes til kunden, og returer håndteres i samme strøm." data-en="Labels generated automatically, tracking sent to the customer, and returns handled in the same flow.">Etiketter genereres automatisk, sporing sendes til kunden, og returer håndteres i samme strøm.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">04</div>
          <div class="cap__body">
            <h4 data-nb="Regnskap og ERP" data-en="Accounting and ERP">Regnskap og ERP</h4>
            <p data-nb="Toveis synkronisering mot Tripletex, Fiken, PowerOffice og Visma. Ordrer, faktura, lager og produkter holdes oppdatert begge veier." data-en="Two-way sync with Tripletex, Fiken, PowerOffice and Visma. Orders, invoices, stock and products stay in sync both ways.">Toveis synkronisering mot Tripletex, Fiken, PowerOffice og Visma. Ordrer, faktura, lager og produkter holdes oppdatert begge veier.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">05</div>
          <div class="cap__body">
            <h4 data-nb="Lager i sanntid" data-en="Real-time inventory">Lager i sanntid</h4>
            <p data-nb="Selg i butikk og på nett uten dobbeltføring. Varsler om lavt lager når det gjelder, ikke i en mappe." data-en="Sell in-store and online without double counting. Low-stock alerts when it matters, not in a folder.">Selg i butikk og på nett uten dobbeltføring. Varsler om lavt lager når det gjelder, ikke i en mappe.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__num">06</div>
          <div class="cap__body">
            <h4 data-nb="API og webhooks" data-en="API and webhooks">API og webhooks</h4>
            <p data-nb="Alt i adminpanelet finnes også som API-kall. Bygg dine egne integrasjoner, eller la oss gjøre det for deg." data-en="Everything in admin is also an API call. Build your own integrations, or let us do it for you.">Alt i adminpanelet finnes også som API-kall. Bygg dine egne integrasjoner, eller la oss gjøre det for deg.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2 data-nb="Se den med dine produkter." data-en="See it with your products.">Se den med dine produkter.</h2>
      <p data-nb="20 minutter på video. Du får se plattformen, en pris og en plan før du legger på." data-en="20 minutes on a video call. You leave with a look at the platform, a price and a plan.">
        20 minutter på video. Du får se plattformen, en pris og en plan før du legger på.
      </p>
      <div class="cta__row">
        <a href="mailto:hei@okane.no?subject=Demo%20Okane%20Commerce" class="btn btn--primary btn--xl" data-nb="Be om en demo →" data-en="Request a demo →">Be om en demo →</a>
        <a href="/" class="btn btn--ghost btn--xl" data-nb="Tilbake til forsiden" data-en="Back to the front page">Tilbake til forsiden</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
