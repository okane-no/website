---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Proof from '~/components/sections/Proof.astro';
import Process from '~/components/sections/Process.astro';
import FAQ from '~/components/sections/FAQ.astro';
import CTA from '~/components/sections/CTA.astro';
import { mailto, prompts } from '~/lib/contact';

const contact = mailto('Integrasjoner', prompts.project);

const faq = [
  {
    q: 'Hvilke systemer kan dere koble sammen?',
    a: 'De fleste som har et API: regnskap og ERP som Tripletex, Fiken, PowerOffice og Visma, betaling, nettbutikk, Altinn og egne fagsystemer. Mangler systemet et API, ser vi på filutveksling eller direkte databasetilgang.',
  },
  {
    q: 'Kan dere hente post og sende skjema i Altinn?',
    a: 'Ja. Vi henter post fra Altinn i Digital Mailroom og sender inn skjema med systembruker i Brage. <a href="/altinn-integrasjon">Slik bygger vi Altinn-integrasjoner</a>.',
  },
  {
    q: 'Hva skjer når en integrasjon feiler?',
    a: 'Integrasjonene vi drifter, overvåker vi, så vi får beskjed når noe feiler. Hver overføring logges, så dere kan se hva som ble sendt, når og hvor.',
  },
  {
    q: 'Hva koster en integrasjon?',
    a: 'Du får en fast pris etter et arbeidsmøte, før vi starter. Drift av integrasjonen kan fortsette på en løpende avtale.',
  },
];
---

<Layout
  title="Altinn-integrasjon og systemintegrasjon · Okane"
  description="Vi kobler Altinn, Tripletex, Fiken, PowerOffice og Visma til systemene dine, så data flyter automatisk og sporbart. Pris før oppstart."
  schema={[{"@type": "Service", "name": "Systemintegrasjon", "serviceType": "Systemintegrasjon", "url": "https://okane.no/integrasjoner", "description": "Integrasjoner mot Altinn, regnskap, ERP og betaling, bygget og driftet av Okane.", "provider": {"@id": "https://okane.no/#org"}, "areaServed": {"@type": "Country", "name": "Norge"}}]}
>
  <Header ctaLabel="Be om pris og plan" ctaHref="#kontakt" ctaEvent="pris-og-plan" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <a href="/#tjenester" data-nb="Tjenester" data-en="Services">Tjenester</a>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span>Slutt på</span><br>
        <em>dobbeltføring.</em>
      </h1>

      <p class="hero__sub">
        Vi kobler systemene dine sammen så data flyter dit de skal, automatisk og sporbart. Altinn er spesialfeltet vårt. Vi henter post fra Altinn og sender inn skjema med systembruker, i egne produkter vi drifter selv.
      </p>

      <div class="hero__cta">
        <a href={contact} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="pris-og-plan">Be om pris og plan</a>
        <a href="/mailroom" class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="se-mailroom">Se Digital Mailroom</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title">Data dit de skal.<br>Av seg selv.</h2>
          <p class="block__sub">
            Hver manuell overføring er en feilkilde og en flaskehals. Vi fjerner dem, én integrasjon om gangen.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4>Altinn</h4>
            <p>Vi henter og arkiverer post fra Altinn automatisk, og sender inn skjema med systembruker og Maskinporten. <a href="/altinn-integrasjon">Mer om Altinn-integrasjon</a>.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>ERP og regnskap</h4>
            <p>Tripletex, Fiken, PowerOffice, Visma og flere. Ordrer, faktura og lager i synk begge veier.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Betaling</h4>
            <p>Vipps, Klarna og kort koblet til systemene dine, med avstemming mot regnskapet.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4>Egne API-er</h4>
            <p>Vi bygger og dokumenterer API-er slik at systemene dine kan brukes av andre, trygt og versjonert.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Proof
    title="Digital Mailroom er Altinn-integrasjonen vi drifter selv."
    text="Den henter post og vedlegg fra Altinn-innboksen, tar imot EHF og e-post i samme strøm og ruter alt til rett person. Canon selger den som Altinn Downloader. Integrasjonen vi bygger for deg, står på samme kode og samme drift."
    href="/mailroom"
    label="Se Digital Mailroom"
    event="se-mailroom"
  />

  <Process />

  <FAQ title="Spørsmål om integrasjoner." sub="Det vi oftest får spørsmål om før en integrasjon. Lurer du på noe annet, er det bare å spørre." items={faq} />

  <CTA
    title="Hvilke systemer krangler hos deg?"
    text="Fortell oss hvor data i dag flyttes for hånd, så svarer vi med hvordan vi ville automatisert det."
    primary={{ label: 'Be om pris og plan', href: contact, event: 'pris-og-plan' }}
    secondary={{ label: 'Les om Altinn-integrasjon', href: '/altinn-integrasjon', event: 'se-altinn-integrasjon' }}
  />

  <Footer />
</Layout>
