---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import CTA from '~/components/sections/CTA.astro';
import { mailto, prompts } from '~/lib/contact';

const demo = mailto('Demo Digital Mailroom', prompts.mailroom);
---

<Layout
  title="Digitalt postmottak for Altinn og EHF – Digital Mailroom"
  description="Digital Mailroom henter post fra Altinn, EHF og e-post til ett mottak og ruter den til rett person. Selges også som Altinn Downloader via Canon."
  image="/og/mailroom.png"
  imageAlt="Digital Mailroom: All post. Ett mottak."
  schema={[{"@type": "SoftwareApplication", "name": "Digital Mailroom", "applicationCategory": "BusinessApplication", "operatingSystem": "Web", "inLanguage": "nb", "url": "https://okane.no/mailroom", "description": "Digitalt postmottak som henter post fra Altinn, EHF og e-post og ruter den til rett person.", "publisher": {"@id": "https://okane.no/#org"}}]}
>
  <Header ctaLabel="Be om en demo" ctaHref="#kontakt" ctaEvent="demo-mailroom" />

  <section class="hero">
    <div class="container">
      <div class="hero__eyebrow">
        <span data-nb="Produkt fra Okane, i drift" data-en="A product by Okane, in production">Produkt fra Okane, i drift</span>
      </div>

      <h1 class="hero__headline hero__headline--page">
        <span data-nb="All post." data-en="All mail.">All post.</span><br>
        <em data-nb="Ett mottak." data-en="One mailroom.">Ett mottak.</em>
      </h1>

      <p class="hero__sub" data-nb="Viktig post fra Altinn leses for sent, av feil person, eller ikke i det hele tatt. Digital Mailroom samler post fra Altinn, EHF og e-post i én strøm og ruter den til rett person." data-en="Important mail from Altinn gets read too late, by the wrong person, or not at all. Digital Mailroom collects mail from Altinn, EHF and email into one stream and routes it to the right person.">
        Viktig post fra Altinn leses for sent, av feil person, eller ikke i det hele tatt. Digital Mailroom samler post fra Altinn, EHF og e-post i én strøm og ruter den til rett person.
      </p>

      <div class="hero__cta">
        <a href={demo} class="btn btn--primary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="demo-mailroom">Be om en demo</a>
        <a href="/altinn-integrasjon" class="btn btn--secondary btn--lg" data-umami-event="cta-click" data-umami-event-location="hero" data-umami-event-label="se-altinn-integrasjon">Les om Altinn-integrasjon</a>
      </div>

      <div class="hero__meta">
        <span><b data-nb="Altinn, EHF og e-post" data-en="Altinn, EHF and email">Altinn, EHF og e-post</b> <span data-nb="i én strøm" data-en="in one stream">i én strøm</span></span>
        <span><b data-nb="Automatisk" data-en="Automatic">Automatisk</b> <span data-nb="ruting" data-en="routing">ruting</span></span>
        <span><b data-nb="Full" data-en="Full">Full</b> <span data-nb="sporbarhet" data-en="traceability">sporbarhet</span></span>
      </div>

      <div class="preview" style="margin-top: var(--space-16); box-shadow: var(--shadow-xl);">
        <div class="preview__bar">
          <div class="lights"><span></span><span></span><span></span></div>
          <div class="preview__url">https://mailroom.okane.no</div>
        </div>
        <div class="preview__body preview__body--flush">
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th data-nb="Dokument" data-en="Document">Dokument</th>
                  <th data-nb="Avsender" data-en="Sender">Avsender</th>
                  <th data-nb="Kanal" data-en="Channel">Kanal</th>
                  <th data-nb="Status" data-en="Status">Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td data-nb="Skattemelding 2025" data-en="Tax return 2025">Skattemelding 2025</td>
                  <td>Skatteetaten</td>
                  <td><span class="mono">Altinn</span></td>
                  <td><span class="badge badge--info"><span class="dot"></span><span data-nb="Rutet til økonomi" data-en="Routed to finance">Rutet til økonomi</span></span></td>
                </tr>
                <tr>
                  <td data-nb="Varsel om tvangsmulkt" data-en="Notice of coercive fine">Varsel om tvangsmulkt</td>
                  <td>Brønnøysundregistrene</td>
                  <td><span class="mono">Altinn</span></td>
                  <td><span class="badge badge--info"><span class="dot"></span><span data-nb="Rutet til daglig leder" data-en="Routed to the CEO">Rutet til daglig leder</span></span></td>
                </tr>
                <tr>
                  <td data-nb="Signert kontrakt" data-en="Signed contract">Signert kontrakt</td>
                  <td>Nordvik Eiendom</td>
                  <td><span class="mono" data-nb="E-post" data-en="Email">E-post</span></td>
                  <td><span class="badge badge--success"><span class="dot"></span><span data-nb="Arkivert" data-en="Archived">Arkivert</span></span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <header class="block__header reveal">
        <div class="block__sub-wrap">
          <h2 class="block__title" data-nb="Fra innboks-kaos&lt;br&gt;til ett arkiv." data-en="From inbox chaos&lt;br&gt;to one archive.">Fra innboks-kaos<br>til ett arkiv.</h2>
          <p class="block__sub" data-nb="All inngående post samles på ett sted og spores til noen har tatt den." data-en="All incoming mail is collected in one place and tracked until someone has picked it up.">
            All inngående post samles på ett sted og spores til noen har tatt den.
          </p>
        </div>
      </header>

      <div class="caps reveal">
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Altinn-innboksen" data-en="The Altinn inbox">Altinn-innboksen</h4>
            <p data-nb="Digital Mailroom overvåker Altinn-innboksen, laster ned nye meldinger og vedlegg og arkiverer dem automatisk." data-en="Digital Mailroom watches your Altinn inbox, downloads new messages and attachments and archives them automatically.">Digital Mailroom overvåker Altinn-innboksen, laster ned nye meldinger og vedlegg og arkiverer dem automatisk.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Automatisk ruting" data-en="Automatic routing">Automatisk ruting</h4>
            <p data-nb="Post rutes til rett person eller avdeling etter regler dere styrer selv." data-en="Mail is routed to the right person or department by rules you control.">Post rutes til rett person eller avdeling etter regler dere styrer selv.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Ett søkbart arkiv" data-en="One searchable archive">Ett søkbart arkiv</h4>
            <p data-nb="Alt lagres samlet og søkbart, med historikk på hvem som har sett og håndtert hva." data-en="Everything is stored in one searchable place, with a history of who has seen and handled what.">Alt lagres samlet og søkbart, med historikk på hvem som har sett og håndtert hva.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="Varsling" data-en="Notifications">Varsling</h4>
            <p data-nb="Rett person får beskjed når noe krever handling, med frister som følges opp." data-en="The right person is notified when something needs action, with deadlines that are followed up.">Rett person får beskjed når noe krever handling, med frister som følges opp.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="EHF og e-post" data-en="EHF and email">EHF og e-post</h4>
            <p data-nb="EHF og e-post havner i samme strøm som Altinn-posten. Én rutine for all inngående post." data-en="EHF and email land in the same stream as your Altinn mail. One routine for all incoming mail.">EHF og e-post havner i samme strøm som Altinn-posten. Én rutine for all inngående post.</p>
          </div>
        </div>
        <div class="cap">
          <div class="cap__body">
            <h4 data-nb="API og eksport" data-en="API and export">API og eksport</h4>
            <p data-nb="Koble arkivet til fagsystemene deres, eller hent alt ut når dere vil." data-en="Connect the archive to your line-of-business systems, or export everything whenever you want.">Koble arkivet til fagsystemene deres, eller hent alt ut når dere vil.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA
    title="Se hvor posten deres havner i dag."
    text="Send noen linjer om hvordan posten håndteres i dag, så viser vi hva Digital Mailroom ville gjort med den."
    primary={{ label: 'Be om en demo', href: demo, event: 'demo-mailroom' }}
    secondary={{ label: 'Les om Altinn-integrasjon', href: '/altinn-integrasjon', event: 'se-altinn-integrasjon' }}
  >
    <p class="cta__aside">Kunde hos Canon? Digital Mailroom selges også gjennom Canon som Altinn Downloader. Spør om den hos din kontakt der.</p>
  </CTA>

  <Footer />
</Layout>
